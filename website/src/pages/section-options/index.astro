---
import { sectionOptionHref, sectionOptions } from "../../data/section-options";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f7faff" />
    <title>CopyLasso section options</title>
    <style>
      :root {
        color-scheme: light;
        font-family: "Avenir Next", "Helvetica Neue", -apple-system, BlinkMacSystemFont, sans-serif;
        background: #f7faff;
        color: #152235;
      }

      * { box-sizing: border-box; }
      body { min-width: 320px; margin: 0; }
      a { color: inherit; }
      a:focus-visible { outline: 3px solid #0872dc; outline-offset: 4px; }
      header, main { width: min(calc(100% - 2rem), 72rem); margin-inline: auto; }

      header { padding: clamp(3rem, 8vw, 7rem) 0 3rem; }
      header > a { color: #0069d2; font-weight: 600; text-decoration: none; }
      h1 {
        max-width: 12ch;
        margin: 1.5rem 0 1rem;
        font-size: clamp(3rem, 8vw, 6.5rem);
        font-weight: 550;
        letter-spacing: -0.065em;
        line-height: 0.94;
      }
      header p { max-width: 46rem; margin: 0; color: #46586d; font-size: 1.15rem; line-height: 1.6; }
      .groups { padding: 0 0 6rem; border-top: 1px solid #a6b8ca; }
      section { padding-top: 2.25rem; }
      section + section { margin-top: 1rem; }
      section > h2 { margin: 0 0 0.75rem; color: #46586d; font-size: 0.95rem; font-weight: 600; }
      ol { padding: 0; margin: 0; list-style: none; }
      li {
        display: grid;
        grid-template-columns: 3rem minmax(0, 1fr) auto;
        gap: 1rem;
        align-items: center;
        padding: 1.25rem 0;
        border-bottom: 1px solid #d8e2ed;
      }
      .number { color: #0069d2; font-weight: 600; }
      h3 { margin: 0 0 0.25rem; font-size: 1.35rem; font-weight: 600; letter-spacing: -0.025em; }
      li p { max-width: 48rem; margin: 0; color: #46586d; line-height: 1.5; }
      .view {
        min-height: 2.75rem;
        display: inline-flex;
        align-items: center;
        padding: 0.6rem 0.9rem;
        border: 1px solid #a6b8ca;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
      }
      .view:hover { border-color: #0069d2; color: #0069d2; }

      @media (max-width: 42rem) {
        li { grid-template-columns: 2rem minmax(0, 1fr); }
        .view { grid-column: 2; justify-self: start; }
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/">← CopyLasso</a>
      <h1>Fast, free, and private.</h1>
      <p>
        Fifteen possible replacements for “Three moves.” Every preview uses the live page, Avenir Next, and the
        existing palette. Only this section changes. Options progress from quiet and simple to more expressive.
      </p>
    </header>

    <main class="groups">
      {(["restrained", "balanced", "expressive"] as const).map((range) => (
        <section aria-labelledby={`${range}-title`}>
          <h2 id={`${range}-title`}>{range[0].toUpperCase() + range.slice(1)}</h2>
          <ol>
            {sectionOptions.filter((option) => option.range === range).map((option) => (
              <li>
                <span class="number">{option.number}</span>
                <div>
                  <h3>{option.name}</h3>
                  <p>{option.thesis}</p>
                </div>
                <a class="view" href={sectionOptionHref(option)}>View option →</a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </main>
  </body>
</html>
