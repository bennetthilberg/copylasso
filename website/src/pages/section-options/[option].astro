---
import {
  sectionOptionHref,
  sectionOptions,
  type SectionOption,
} from "../../data/section-options";

export function getStaticPaths() {
  return sectionOptions.map((option) => ({
    params: { option: `option-${option.number}` },
    props: { option },
  }));
}

interface Props {
  option: SectionOption;
}

const { option } = Astro.props;
const previous = sectionOptions[(option.number - 2 + sectionOptions.length) % sectionOptions.length];
const next = sectionOptions[option.number % sectionOptions.length];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#111827" />
    <title>{option.name} · CopyLasso section options</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
        background: #111827;
      }
      * { box-sizing: border-box; }
      body { min-width: 320px; margin: 0; overflow: hidden; }
      a, summary { color: inherit; }
      a:focus-visible, summary:focus-visible { outline: 3px solid #60a5fa; outline-offset: 3px; }
      .option-nav {
        position: fixed;
        z-index: 10;
        inset: 0 0 auto;
        min-height: 3.75rem;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto auto auto;
        gap: 0.65rem;
        align-items: center;
        padding: 0.55rem 0.75rem;
        border-bottom: 1px solid #374151;
        background: #111827;
        color: #f9fafb;
        font-size: 0.875rem;
      }
      .option-nav a, .option-nav summary {
        min-height: 2.5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.45rem 0.7rem;
        border: 1px solid #4b5563;
        border-radius: 6px;
        text-decoration: none;
      }
      .option-nav a:hover { border-color: #93c5fd; }
      .option-title { min-width: 0; display: flex; gap: 0.65rem; align-items: baseline; }
      .option-title span { color: #9ca3af; white-space: nowrap; }
      .option-title strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      details { position: relative; }
      summary { cursor: pointer; list-style: none; }
      summary::-webkit-details-marker { display: none; }
      details ol {
        position: absolute;
        top: calc(100% + 0.45rem);
        right: 0;
        width: 18rem;
        max-height: min(75vh, 34rem);
        padding: 0.4rem;
        margin: 0;
        overflow-y: auto;
        border: 1px solid #4b5563;
        border-radius: 8px;
        background: #111827;
        box-shadow: 0 16px 40px rgb(0 0 0 / 0.35);
        list-style: none;
      }
      details li a { width: 100%; justify-content: flex-start; border-color: transparent; }
      details li a[aria-current="page"] { border-color: #60a5fa; background: #1f2937; }
      .preview-status {
        position: fixed;
        z-index: 2;
        inset: 3.75rem 0 0;
        display: grid;
        place-items: center;
        background: #f7faff;
        color: #46586d;
        font-size: 0.9rem;
      }
      iframe {
        position: fixed;
        z-index: 3;
        inset: 3.75rem 0 0;
        width: 100%;
        height: calc(100dvh - 3.75rem);
        border: 0;
        background: #f7faff;
        opacity: 0;
      }
      iframe.is-ready { opacity: 1; }

      @media (max-width: 46rem) {
        .option-nav { grid-template-columns: auto minmax(0, 1fr) auto; }
        .option-nav > a[rel] { display: none; }
        .option-title span { display: none; }
      }
    </style>
  </head>
  <body>
    <nav class="option-nav" aria-label="Section option navigator">
      <a href="/section-options/" aria-label="Back to all section options">All options</a>
      <div class="option-title">
        <span>{option.number} / {sectionOptions.length}</span>
        <strong>{option.name}</strong>
      </div>
      <details>
        <summary>Choose</summary>
        <ol>
          {sectionOptions.map((item) => (
            <li>
              <a href={sectionOptionHref(item)} aria-current={item.number === option.number ? "page" : undefined}>
                {item.number}. {item.name}
              </a>
            </li>
          ))}
        </ol>
      </details>
      <a href={sectionOptionHref(previous)} rel="prev" aria-label={`Previous option: ${previous.name}`}>← Previous</a>
      <a href={sectionOptionHref(next)} rel="next" aria-label={`Next option: ${next.name}`}>Next →</a>
    </nav>

    <div class="preview-status" id="preview-status" role="status">Loading {option.name}…</div>
    <iframe id="section-preview" src="/" title={`CopyLasso landing page with ${option.name}`}></iframe>

