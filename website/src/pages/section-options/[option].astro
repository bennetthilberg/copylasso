        .value-manifesto { max-width: 66rem; }
        .value-manifesto > p { display: grid; grid-template-columns: minmax(18rem,.85fr) 1fr; gap: 3rem; align-items: baseline; padding: 1.5rem 0; margin: 0; border-bottom: 1px solid var(--line); }
        .value-manifesto h2 { margin-bottom: 2.5rem; }
        .value-manifesto > p strong { color: var(--ink); font-size: clamp(1.5rem,3vw,2.5rem); letter-spacing: -.04em; }
        .value-manifesto > p span { color: var(--ink-soft); }
        .value-manifesto .value-manifesto-note { display: block; max-width: 44rem; margin-left: auto; padding-top: 2rem; border: 0; text-align: right; }
        .value-refusal h2 { max-width: 12ch; }
        .value-no-list { display: grid; margin-top: 3rem; border-top: 1px solid var(--ink); }
        .value-no-list span { padding: 1rem 0; border-bottom: 1px solid var(--line); font-size: clamp(2rem,5vw,4.5rem); font-weight: 500; letter-spacing: -.055em; line-height: 1; }
        .value-no-list span:nth-child(2) { padding-left: 14%; }
        .value-no-list span:nth-child(3) { padding-left: 28%; }
        .value-refusal > details { max-width: 50rem; margin: 2.5rem 0 0 auto; border-block: 1px solid var(--line-strong); }
        .value-refusal > details summary { display: flex; justify-content: space-between; gap: 1rem; padding: 1.1rem 0; cursor: pointer; color: var(--blue-ink); font-weight: 600; list-style: none; }
        .value-refusal > details summary::-webkit-details-marker { display: none; }
        .value-refusal > details[open] summary span { transform: rotate(45deg); }
        .value-refusal > details div { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; padding-bottom: 1rem; }
        .value-refusal > details p { margin: 0; }

        @media (max-width: 52rem) {
          .value-split, .value-size-layout { grid-template-columns: 1fr; }
          .value-ledger-head { display: block; }
          .value-ledger-head p { margin-top: 1rem; }
          .value-ledger { grid-template-columns: 1fr; }
          .value-ledger > div:nth-child(odd), .value-ledger > div:nth-child(even) { padding-right: 0; padding-left: 0; border-left: 0; }
          .value-flow { grid-template-columns: 1fr; }
          .value-flow li, .value-flow li + li { min-height: auto; padding: 1.5rem 0; border-left: 0; }
          .value-flow li + li { border-top: 1px solid var(--line); }
          .value-flow li:not(:last-child)::after { display: none; }
          .value-coda, .value-boundary, .value-always-optional { grid-template-columns: 1fr; }
          .value-boundary > div, .value-boundary > div + div, .value-always-optional > div, .value-always-optional > div + div { padding: 2rem 0; border-left: 0; }
          .value-boundary > div + div, .value-always-optional > div + div { border-top: 1px solid var(--line); }
          .value-triptych, .value-three-proof { grid-template-columns: 1fr; }
          .value-triptych > div + div, .value-three-proof article + article { border-top: 1px solid var(--line); border-left: 0; }
          .value-path { grid-template-columns: 1fr; gap: 1rem; }
          .value-path::before { top: .5rem; bottom: .5rem; left: .5rem; width: 2px; height: auto; }
          .value-path span { padding: 0 0 0 2rem; text-align: left; }
          .value-path span::before { top: .25rem; left: 0; transform: none; }
          .value-path-end { align-items: flex-start; flex-direction: column; }
          .value-io { grid-template-columns: 1fr; }
          .value-io-arrow { transform: rotate(90deg); }
          .value-io-empty { grid-column: auto; }
          .value-manifesto > p { grid-template-columns: 1fr; gap: .5rem; }
          .value-refusal > details div { grid-template-columns: 1fr; }
        }
        @media (max-width: 38rem) {
          .value-rows > div, .value-pairs > div { grid-template-columns: 1fr; gap: .35rem; }
          .value-ledger > div { grid-template-columns: 6.75rem 1fr; }
          .value-no-list span:nth-child(n) { padding-left: 0; }
          .value-size { min-height: 16rem; }
        }
      `;

      frame.addEventListener("load", () => {
        const doc = frame.contentDocument;
        if (!doc) {
          status.textContent = "The section preview could not be loaded.";
          return;
        }

        const existing = doc.querySelector("#how-it-works");
        if (!existing) {
          status.textContent = "The section to replace could not be found.";
          return;
        }

        const section = doc.createElement("section");
        section.id = "how-it-works";
        section.className = `value-lab value-option-${option.number}`;
        section.setAttribute("aria-labelledby", "workflow-title");
        section.innerHTML = variants[option.number];
        existing.replaceWith(section);

        const style = doc.createElement("style");
        style.textContent = injectedStyles;
        doc.head.append(style);

        requestAnimationFrame(() => {
          doc.documentElement.style.scrollBehavior = "auto";
          doc.defaultView?.scrollTo(0, Math.max(0, section.offsetTop - 24));
          frame.classList.add("is-ready");
          status.hidden = true;
        });
      });

      document.addEventListener("keydown", (event) => {
        const tag = event.target?.tagName?.toLowerCase();
        if (tag === "input" || tag === "textarea" || tag === "select" || event.metaKey || event.ctrlKey || event.altKey) return;
        if (event.key === "ArrowLeft") window.location.href = document.querySelector('[rel="prev"]').href;
        if (event.key === "ArrowRight") window.location.href = document.querySelector('[rel="next"]').href;
      });
    </script>
  </body>
</html>
