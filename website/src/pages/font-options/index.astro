---
import { fontOptionHref, fontOptions } from "../../data/font-options";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f7faff" />
    <title>CopyLasso font options</title>
    <style>
      :root {
        color-scheme: light;
        font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
        background: #f7faff;
        color: #152235;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-width: 320px;
        margin: 0;
      }

      a {
        color: inherit;
      }

      a:focus-visible {
        outline: 3px solid #0872dc;
        outline-offset: 4px;
      }

      header,
      main {
        width: min(calc(100% - 2rem), 68rem);
        margin-inline: auto;
      }

      header {
        padding: clamp(3rem, 8vw, 7rem) 0 3rem;
      }

      header a {
        color: #0069d2;
        font-weight: 650;
        text-decoration: none;
      }

      h1 {
        max-width: 13ch;
        margin: 1.5rem 0 1rem;
        font-size: clamp(3rem, 8vw, 6.5rem);
        font-weight: 650;
        letter-spacing: -0.065em;
        line-height: 0.94;
      }

      header p {
        max-width: 44rem;
        margin: 0;
        color: #46586d;
        font-size: 1.15rem;
        line-height: 1.6;
      }

      ol {
        padding: 0 0 6rem;
        margin: 0;
        border-top: 1px solid #a6b8ca;
        list-style: none;
      }

      li {
        display: grid;
        grid-template-columns: 3rem minmax(0, 1fr) auto;
        gap: 1rem;
        align-items: center;
        padding: 1.35rem 0;
        border-bottom: 1px solid #d8e2ed;
      }

      .number {
        color: #0069d2;
        font-weight: 700;
      }

      h2 {
        margin: 0 0 0.25rem;
        font-size: 1.35rem;
        font-weight: 650;
        letter-spacing: -0.025em;
      }

      li p {
        max-width: 48rem;
        margin: 0;
        color: #46586d;
        line-height: 1.5;
      }

      .view {
        min-height: 2.75rem;
        display: inline-flex;
        align-items: center;
        padding: 0.6rem 0.9rem;
        border: 1px solid #a6b8ca;
        border-radius: 8px;
        font-weight: 650;
        text-decoration: none;
      }

      .view:hover {
        border-color: #0069d2;
        color: #0069d2;
      }

      @media (max-width: 42rem) {
        li {
          grid-template-columns: 2rem minmax(0, 1fr);
        }

        .view {
          grid-column: 2;
          justify-self: start;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/">← CopyLasso</a>
      <h1>Ten fonts. One page.</h1>
      <p>
        Every route below renders the current landing page without layout, color, spacing, copy, or motion changes.
        Only the typeface changes. The multilingual specimen uses explicit sans-serif companions for Chinese,
        Japanese, and Arabic.
      </p>
    </header>

    <main>
      <ol>
        {fontOptions.map((option) => (
          <li>
            <span class="number">{option.number}</span>
            <div>
              <h2>{option.name}</h2>
              <p>{option.thesis}</p>
            </div>
            <a class="view" href={fontOptionHref(option)}>View font →</a>
          </li>
        ))}
      </ol>
    </main>
  </body>
</html>

