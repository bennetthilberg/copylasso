---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { compatibilityFacts, features, privacyFacts, site } from "../../data/site";

const description =
  "Window Within is a light, macOS-like CopyLasso direction that shows screen selection becoming clipboard text.";

const qrCells = [
  ..."111111101",
  ..."100000100",
  ..."101110111",
  ..."101110001",
  ..."101110101",
  ..."100000100",
  ..."111111101",
  ..."001010011",
  ..."101110101",
];
---

<SiteLayout
  title="Window Within · CopyLasso"
  description={description}
  optionNumber={6}
  optionName="Window Within"
  previousHref="/design-options/option-5/"
  nextHref="/design-options/"
>
  <div class="window-within-page">
    <header class="window-within-header">
      <div class="window-within-width header-inner">
        <a class="window-within-brand" href="/design-options/" aria-label="CopyLasso home">CopyLasso</a>
        <nav class="window-within-nav" aria-label="Page sections">
          <a href="#how-it-works">How it works</a>
          <a href="#features">Features</a>
          <a href="#privacy">Privacy</a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <section class="window-within-hero window-within-width" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">Copy anything on your screen.</h1>
          <p class="hero-lede">
            CopyLasso turns a selected region of your Mac into plain text you can paste anywhere. It
            stays local, so the useful part feels as quick as the gesture.
          </p>
          <div class="hero-actions">
            <a class="download-button" href="#download">
              <span>{site.downloadLabel}</span>
              <svg
                class="download-icon"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M12 3.5v10.5"></path>
                <path d="m7.5 10.5 4.5 4.5 4.5-4.5"></path>
                <path d="M4 17.5h3l1.1 2h7.8l1.1-2h3v3H4z"></path>
              </svg>
            </a>
            <a class="hero-source" href={site.githubUrl} target="_blank" rel="noreferrer">
              View source on GitHub
            </a>
          </div>
          <p class="hero-requirements">{site.requirements}</p>
        </div>

        <div class="hero-visual">
          <div class="window-visual" aria-hidden="true">
            <div class="window-frame">
              <div class="window-titlebar">
                <div class="window-titlebar-main">
                  <span class="window-app-name">Notes</span>
                  <span class="window-app-path">Planning board</span>
                </div>
                <span class="window-view-name">Document view</span>
              </div>

              <div class="window-content">
                <aside class="window-sidebar">
                  <span class="sidebar-heading">Folders</span>
                  <span class="sidebar-item sidebar-item-current">Today</span>
                  <span class="sidebar-item">Projects</span>
                  <span class="sidebar-item">Shared</span>
                </aside>

                <div class="document-surface">
                  <div class="document-heading">
                    <div>
                      <p class="document-title">Launch plan</p>
                      <p class="document-subtitle">Notes for the product team</p>
                    </div>
                    <span class="document-date">This week</span>
                  </div>

                  <div class="sheet-grid">
                    <div class="sheet-row sheet-header-row">
                      <span>Task</span>
                      <span>Owner</span>
                      <span>Status</span>
                    </div>
                    <div class="sheet-row">
                      <span>Product tour</span>
                      <span>Bennett</span>
                      <span class="sheet-status">Ready</span>
                    </div>
                    <div class="sheet-row">
                      <span>Release notes</span>
                      <span>Sam</span>
                      <span class="sheet-status">Review</span>
                    </div>
                    <div class="sheet-row">
                      <span>Customer examples</span>
                      <span>Alex</span>
                      <span class="sheet-status">Draft</span>
                    </div>
                    <div class="sheet-row">
                      <span>Support handoff</span>
                      <span>Team</span>
                      <span class="sheet-status">Ready</span>
                    </div>
                  </div>

                  <div class="selection-box">
                    <p>Text you can already see.</p>
                  </div>
                </div>
              </div>

              <div class="result-drawer">
                <div>
                  <p class="result-title">Copied to clipboard</p>
                  <p class="result-text">Text you can already see.</p>
                </div>
                <span class="result-kind">Plain text</span>
              </div>
            </div>
          </div>
          <p class="sr-only">
            Decorative preview: a light document window shows a blue selection box over a launch plan,
            followed by a plain-text result marked Copied to clipboard.
          </p>
        </div>
      </section>

      <section id="how-it-works" class="within-section workflow-section" aria-labelledby="workflow-title">
        <div class="window-within-width">
          <div class="section-intro">
            <h2 id="workflow-title">Three moves, then keep working.</h2>
            <p>
              The window is the whole idea: bring the pixels into view, draw one region, and get a
              result that is ready for the app already in front of you.
            </p>
          </div>

          <ol class="workflow-list">
            <li>
              <span class="workflow-number" aria-hidden="true">1</span>
              <div>
                <h3>Press the shortcut</h3>
                <p>Use <span class="shortcut-key" aria-label="Shift Command 2">{site.shortcut}</span> to start a capture.</p>
              </div>
            </li>
            <li>
              <span class="workflow-number" aria-hidden="true">2</span>
              <div>
                <h3>Select a region</h3>
                <p>Drag around the text, code, or message you want to carry forward.</p>
              </div>
            </li>
            <li>
              <span class="workflow-number" aria-hidden="true">3</span>
              <div>
                <h3>Copy and paste</h3>
                <p>Apple Vision recognizes it locally and leaves plain text on your clipboard.</p>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <section id="features" class="within-section features-section" aria-labelledby="features-title">
        <div class="window-within-width">
          <div class="section-intro">
            <h2 id="features-title">It reads whatever the window shows.</h2>
            <p>
              The same selection gesture handles ordinary text, scannable codes, and the scripts that
              make a screen useful to more people.
            </p>
          </div>

          <div class="proof-grid">
            <article class="proof-item">
              <div class="qr-visual" aria-hidden="true">
                {qrCells.map((cell) => <span class={cell === "1" ? "qr-dark" : ""}></span>)}
              </div>
              <h3>QR and barcode recognition</h3>
              <p>{features[2].body}</p>
            </article>

            <article class="proof-item">
              <div class="scripts-visual" aria-hidden="true">
                <span lang="en">Copy</span>
                <span lang="es">Copiar</span>
                <span lang="ja">コピー</span>
                <span lang="ko">복사</span>
              </div>
              <h3>Languages that fit the screen</h3>
              <p>{features[3].body}</p>
            </article>

            <article class="proof-item">
              <div class="characters-visual" aria-hidden="true">
                <div><span>&lt; / &gt;</span><span>visible</span></div>
                <div><span>&#123; &#125;</span><span>selected</span></div>
                <div><span>[ ]</span><span>copied</span></div>
                <div><span>#</span><span>plain text</span></div>
              </div>
              <h3>Text from pixels</h3>
              <p>{features[0].body}</p>
            </article>
          </div>

          <p class="proof-note">{features[1].body}</p>
        </div>
      </section>

      <section id="privacy" class="within-section privacy-section" aria-labelledby="privacy-title">
        <div class="window-within-width split-section">
          <div class="section-intro">
            <h2 id="privacy-title">Your screen stays on your Mac.</h2>
            <p>
              CopyLasso has a narrow job and a clear boundary. Capture and recognition happen locally,
              and screenshots are temporary by design.
            </p>
          </div>

          <ul class="fact-list">
            {privacyFacts.map((fact) => (
              <li>
                <span class="fact-rule" aria-hidden="true"></span>
                <span>{fact}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="compatibility" class="within-section compatibility-section" aria-labelledby="compatibility-title">
        <div class="window-within-width split-section">
          <div class="section-intro">
            <h2 id="compatibility-title">Ready for the Mac you use.</h2>
            <p>
              A free, open-source menu-bar utility for macOS. Give region capture one permission, then
              keep the rest of the workflow close to home.
            </p>
          </div>

          <div>
            <ul class="compatibility-list">
              {compatibilityFacts.map((fact) => <li>{fact}</li>)}
            </ul>
            <p class="compatibility-note">{features[5].body}</p>
          </div>
        </div>
      </section>

      <section id="download" class="download-section" aria-labelledby="download-title">
        <div class="window-within-width download-inner">
          <div>
            <h2 id="download-title">Make the next screen copyable.</h2>
            <p>Free, open source, and local by design.</p>
          </div>
          <a class="download-source" href={site.githubUrl} target="_blank" rel="noreferrer">Read the MIT-licensed source</a>
        </div>
      </section>
    </main>

    <footer class="window-within-footer">
      <div class="window-within-width footer-inner">
        <p>Created by <a href={`mailto:${site.email}`}>Bennett Hilberg</a>.</p>
        <div class="footer-links">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.githubUrl} target="_blank" rel="noreferrer">View source on GitHub</a>
          <span>MIT licensed.</span>
        </div>
      </div>
    </footer>
  </div>
</SiteLayout>

<style>
  .window-within-page {
    min-width: 0;
    overflow-x: clip;
    padding-bottom: 4rem;
  }

  .window-within-width {
    width: min(calc(100% - 2rem), 74rem);
    margin-inline: auto;
  }

  .window-within-header {
    padding-top: 1.25rem;
  }

  .header-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .window-within-brand {
    color: var(--ink);
    font-size: 1.08rem;
    font-weight: 600;
    text-decoration: none;
  }

  .window-within-brand:hover {
    color: var(--ink);
  }

  .window-within-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.4rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .window-within-nav a {
    text-decoration: none;
  }

  .window-within-hero {
    display: grid;
    grid-template-columns: minmax(16rem, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
    padding-block: clamp(4.5rem, 10vw, 8rem) clamp(5rem, 10vw, 8.5rem);
  }

  .hero-copy,
  .hero-visual,
  .window-visual,
  .window-frame,
  .window-content,
  .document-surface {
    min-width: 0;
  }

  .hero-copy h1 {
    max-width: 8ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(3.45rem, 7.25vw, 7rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.93;
  }

  .hero-lede {
    max-width: 35rem;
    margin: clamp(1.8rem, 4vw, 2.8rem) 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.08rem, 1.5vw, 1.3rem);
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .download-button {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    padding: 0.85rem 1.15rem;
    border-radius: var(--r-control);
    background: var(--blue);
    color: var(--blue-white);
    font-weight: 600;
    line-height: 1.1;
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .download-button:hover {
    background: var(--blue-deep);
    color: var(--blue-white);
    transform: translateY(-2px);
  }

  .download-icon {
    flex: 0 0 auto;
  }

  .hero-source,
  .download-source {
    color: var(--blue-ink);
    font-size: 1rem;
    font-weight: 600;
    text-underline-offset: 0.2em;
  }

  .hero-requirements {
    margin: 1.35rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .window-visual {
    position: relative;
  }

  .window-frame {
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-surface);
    background: var(--paper);
    box-shadow: 0 22px 52px rgb(8 34 78 / 0.13);
  }

  .window-titlebar {
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.15rem;
    border-bottom: 1px solid var(--line-strong);
    background: var(--paper-deep);
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .window-titlebar-main {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 0.65rem;
  }

  .window-app-name {
    color: var(--ink);
    font-weight: 600;
  }

  .window-app-path,
  .window-view-name {
    color: var(--muted);
  }

  .window-app-path {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .window-content {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    min-height: 25rem;
    background: var(--paper-deep);
  }

  .window-sidebar {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: 1.25rem 0.85rem;
    border-right: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .sidebar-heading {
    margin: 0 0 0.55rem 0.35rem;
    color: var(--muted);
  }

  .sidebar-item {
    padding: 0.52rem 0.55rem;
    border-radius: 6px;
  }

  .sidebar-item-current {
    background: var(--blue-pale);
    color: var(--blue-ink);
    font-weight: 600;
  }

  .document-surface {
    position: relative;
    margin: 1.15rem;
    padding: clamp(1.15rem, 2.7vw, 1.9rem);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-control);
    background: var(--paper);
  }

  .document-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .document-title,
  .document-subtitle,
  .document-date,
  .result-title,
  .result-text {
    margin: 0;
  }

  .document-title {
    color: var(--ink);
    font-size: clamp(1.35rem, 2.3vw, 1.8rem);
    font-weight: 400;
    line-height: 1.1;
  }

  .document-subtitle,
  .document-date {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .document-subtitle {
    margin-top: 0.35rem;
  }

  .document-date {
    flex: 0 0 auto;
  }

  .sheet-grid {
    margin-top: 1.6rem;
    border-top: 1px solid var(--line-strong);
  }

  .sheet-row {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 0.9fr) minmax(0, 0.75fr);
    gap: 0.7rem;
    align-items: baseline;
    padding: 0.78rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.88rem;
  }

  .sheet-header-row {
    color: var(--muted);
  }

  .sheet-status {
    color: var(--green);
    font-weight: 600;
  }

  .selection-box {
    position: absolute;
    inset: 34% 5% 19% 5%;
    display: flex;
    align-items: flex-end;
    padding: 1rem;
    border: 2px solid var(--blue);
    background: rgb(226 237 255 / 0.72);
    color: var(--blue-ink);
    clip-path: inset(0);
    animation: draw-selection 6.5s var(--ease-out) infinite;
  }

  .selection-box p {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(1rem, 1.7vw, 1.25rem);
    font-weight: 500;
    line-height: 1.1;
  }

  .result-drawer {
    display: flex;
    min-height: 5.2rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--line-strong);
    background: var(--paper);
    animation: result-arrives 6.5s var(--ease-out) infinite;
  }

  .result-title {
    color: var(--ink);
    font-size: 1rem;
    font-weight: 600;
  }

  .result-text,
  .result-kind {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .result-text {
    margin-top: 0.2rem;
  }

  .result-kind {
    flex: 0 0 auto;
  }

  .within-section {
    padding-block: clamp(5rem, 10vw, 8.5rem);
    border-top: 1px solid var(--line-strong);
  }

  .section-intro {
    max-width: 40rem;
  }

  .section-intro h2 {
    max-width: 16ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.2rem, 4.5vw, 4.1rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  .section-intro p {
    max-width: 40rem;
    margin: 1.35rem 0 0;
    color: var(--ink-soft);
    font-size: 1.08rem;
    line-height: 1.55;
  }

  .workflow-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .workflow-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-strong);
  }

  .workflow-number {
    color: var(--blue);
    font-size: 2.1rem;
    font-weight: 400;
    line-height: 1;
  }

  .workflow-list h3,
  .proof-item h3 {
    margin: 0;
    color: var(--ink);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .workflow-list p,
  .proof-item p {
    margin: 0.55rem 0 0;
    color: var(--ink-soft);
    line-height: 1.55;
  }

  .shortcut-key {
    display: inline-block;
    padding: 0.08rem 0.28rem;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    background: var(--paper-deep);
    color: var(--ink);
    font: inherit;
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3.5vw, 3.5rem);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .proof-item {
    min-width: 0;
    padding-top: 1.35rem;
    border-top: 1px solid var(--line-strong);
  }

  .proof-item h3 {
    margin-top: 1.5rem;
  }

  .qr-visual {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    width: min(100%, 12.5rem);
    aspect-ratio: 1;
    gap: 0.18rem;
    padding: 0.65rem;
    border: 1px solid var(--line-strong);
    background: var(--blue-pale);
  }

  .qr-visual span {
    min-width: 0;
    min-height: 0;
    background: var(--blue-white);
  }

  .qr-visual .qr-dark {
    background: var(--blue-deep);
  }

  .scripts-visual {
    display: grid;
    align-content: start;
    min-height: 12.5rem;
    padding: 0.2rem 0;
  }

  .scripts-visual span {
    display: block;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: clamp(1.3rem, 2.8vw, 2rem);
    line-height: 1.1;
  }

  .scripts-visual span:nth-child(2) {
    padding-left: 1.35rem;
    color: var(--blue-ink);
  }

  .scripts-visual span:nth-child(3) {
    padding-left: 2.7rem;
  }

  .scripts-visual span:nth-child(4) {
    padding-left: 4.05rem;
    border-bottom: 0;
    color: var(--blue-ink);
  }

  .characters-visual {
    display: grid;
    min-height: 12.5rem;
    align-content: start;
    border-top: 1px solid var(--line);
  }

  .characters-visual div {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }

  .characters-visual span:first-child {
    color: var(--blue);
    font-size: 1.35rem;
    font-weight: 500;
  }

  .characters-visual span:last-child {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .proof-note {
    max-width: 42rem;
    margin: 3rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .split-section {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    align-items: start;
  }

  .privacy-section {
    background: var(--paper-deep);
  }

  .fact-list,
  .compatibility-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fact-list li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line-strong);
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .fact-list li:first-child {
    padding-top: 0;
  }

  .fact-rule {
    width: 1.5rem;
    height: 2px;
