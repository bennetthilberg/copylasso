---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { compatibilityFacts, features, privacyFacts, site } from "../../data/site";

const qrPattern = [
  "1111111010101",
  "1000001011101",
  "1011101000101",
  "1011101010101",
  "1011101001101",
  "1000001010101",
  "1111111010101",
  "0010010111010",
  "1101101001011",
  "0101010110100",
  "1010011101110",
  "0110100010011",
  "1101011011101",
];

const qrCells = qrPattern.flatMap((row) => row.split(""));
const description =
  "CopyLasso turns a selected region of your Mac screen into clean clipboard text with local Apple Vision OCR.";
---

<SiteLayout
  title="Clipboard First · CopyLasso"
  description={description}
  optionNumber={5}
  optionName="Clipboard First"
  previousHref="/design-options/option-4/"
  nextHref="/design-options/option-6/"
>
  <div class="clipboard-page">
    <header class="page-header">
      <a class="brand" href="#main-content" aria-label="CopyLasso home">
        <span class="brand-mark" aria-hidden="true"></span>
        <span>{site.name}</span>
      </a>

      <nav class="page-nav" aria-label="Page sections">
        <a href="#how-it-works">How it works</a>
        <a href="#proof">Proof</a>
        <a href="#privacy">Privacy</a>
        <a href={site.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero-section" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <h1 id="hero-heading">Copy anything on your screen.</h1>
          <p class="hero-lede">
            CopyLasso puts the result first. Select the words you can see, and a clean plain-text copy is ready for
            the next app before you leave the one you are using.
          </p>

          <div class="hero-actions">
            <a class="download-button" href={site.downloadHref}>
              <span>{site.downloadLabel}</span>
              <svg class="download-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 3v11"></path>
                <path d="m7.5 10 4.5 4.5 4.5-4.5"></path>
                <path d="M4 16.5v4h16v-4"></path>
              </svg>
            </a>
            <a class="source-link" href={site.githubUrl} target="_blank" rel="noreferrer">View source on GitHub</a>
            <p class="hero-requirements">{site.requirements}</p>
          </div>
        </div>

        <figure class="hero-visual" aria-hidden="true">
          <div class="source-window">
            <div class="source-window-bar">
              <span class="source-window-title">Team chat</span>
              <span class="source-window-context">Project notes</span>
            </div>

            <div class="source-window-body">
              <aside class="source-sidebar">
                <span class="sidebar-heading">Channels</span>
                <span class="sidebar-item sidebar-item-active">Launch</span>
                <span class="sidebar-item">Design</span>
                <span class="sidebar-item">Support</span>
                <span class="sidebar-heading sidebar-heading-spaced">Direct</span>
                <span class="sidebar-item">Maya Chen</span>
              </aside>

              <div class="source-thread">
                <div class="thread-heading">
                  <strong>Launch</strong>
                  <span>3 messages</span>
                </div>

                <article class="chat-message">
                  <span class="message-avatar">MC</span>
                  <div class="message-content">
                    <strong>Maya Chen</strong>
                    <p>Keep the source app open.</p>
                  </div>
                </article>

                <article class="chat-message chat-message-selected">
                  <span class="message-avatar message-avatar-blue">JR</span>
                  <div class="message-content">
                    <strong>Jon Rivera</strong>
                    <p>Copy only the words you need.</p>
                  </div>
                </article>

                <article class="chat-message chat-message-muted">
                  <span class="message-avatar">AK</span>
                  <div class="message-content">
                    <strong>Alex Kim</strong>
                    <p>The result stays on your Mac.</p>
                  </div>
                </article>

                <div class="source-selection">
                  <span class="selection-label">Selected text</span>
                </div>
              </div>
            </div>
          </div>

          <div class="clipboard-sheet">
            <div class="clipboard-clip" aria-hidden="true"></div>
            <div class="clipboard-sheet-header">
              <span>Clipboard result</span>
              <span>Plain text</span>
            </div>
            <div class="clipboard-sheet-rule" aria-hidden="true"></div>
            <div class="clipboard-copy">
              <p>Keep the source app open.</p>
              <p>Copy only the words you need.</p>
            </div>
            <div class="clipboard-confirmation">
              <span class="confirmation-check" aria-hidden="true">✓</span>
              <span>Copied to clipboard</span>
            </div>
          </div>
        </figure>
      </section>

      <section id="how-it-works" class="content-section process-section" aria-labelledby="process-heading">
        <div class="section-intro">
          <h2 id="process-heading">Three moves. One clean result.</h2>
          <p>
            The source can be a document, a message, a photo, or a remote desktop. CopyLasso only needs the pixels you
            choose.
          </p>
        </div>

        <ol class="process-list">
          <li class="process-step">
            <span class="process-step-key"><kbd>{site.shortcut}</kbd></span>
            <div>
              <h3>Press the shortcut</h3>
              <p>Bring up the system selection crosshair without leaving the app in front of you.</p>
            </div>
          </li>
          <li class="process-step">
            <span class="process-step-key" aria-hidden="true">02</span>
            <div>
              <h3>Select the words</h3>
              <p>Draw a region around text, a QR code, a barcode, or anything else visible on screen.</p>
            </div>
          </li>
          <li class="process-step">
            <span class="process-step-key" aria-hidden="true">03</span>
            <div>
              <h3>Copy and continue</h3>
              <p>Local Apple Vision recognition leaves the useful result as plain text on your clipboard.</p>
            </div>
          </li>
        </ol>
      </section>

      <section id="proof" class="content-section proof-section" aria-labelledby="proof-heading">
        <div class="section-intro">
          <h2 id="proof-heading">The clipboard can carry more than a sentence.</h2>
          <p>
            The same selection gesture handles the text that normally gets stranded inside images, interfaces, and
            screenshots.
          </p>
        </div>

        <div class="proof-grid">
          <article class="proof-item">
            <div class="language-sample" aria-hidden="true">
              <span>Bonjour, CopyLasso.</span>
              <span>こんにちは、CopyLasso。</span>
              <span>مرحبا، CopyLasso.</span>
            </div>
            <h3>Multiple scripts</h3>
            <p>{features[3].body}</p>
          </article>

          <article class="proof-item">
            <div class="code-sample" aria-hidden="true">
              <span><b>let</b> selectedText = “visible words”;</span>
              <span><b>return</b> selectedText;</span>
            </div>
            <h3>Code characters</h3>
            <p>Keep punctuation, symbols, and line breaks useful when the source is a code sample.</p>
          </article>

          <article class="proof-item">
            <div class="qr-sample" aria-hidden="true">
              <div class="qr-code">
                {qrCells.map((cell) => <span class:list={["qr-cell", cell === "1" && "qr-cell-filled"]}></span>)}
              </div>
              <span class="qr-result">plain text result</span>
            </div>
            <h3>Codes included</h3>
            <p>{features[2].body}</p>
          </article>
        </div>
      </section>

      <section id="privacy" class="content-section privacy-section" aria-labelledby="privacy-heading">
        <div class="split-content">
          <div class="section-intro">
            <h2 id="privacy-heading">The clipboard stays yours.</h2>
            <p>
              The capture is temporary by design. Recognition happens on this Mac, and CopyLasso does not need an
              account or a cloud handoff to do its job.
            </p>
          </div>

          <ul class="fact-list">
            {privacyFacts.map((fact) => <li>{fact}</li>)}
          </ul>
        </div>
      </section>

      <section id="compatibility" class="content-section compatibility-section" aria-labelledby="compatibility-heading">
        <div class="split-content">
          <div class="section-intro">
            <h2 id="compatibility-heading">Ready for the Mac you use.</h2>
            <p>
              CopyLasso is a free, open-source utility that stays in the menu bar. Give it Screen Recording permission
              once so it can read the region you choose.
            </p>
          </div>

          <ul class="fact-list compatibility-list">
            {compatibilityFacts.map((fact) => <li>{fact}</li>)}
          </ul>
        </div>
      </section>

      <section id="download" class="download-section" aria-labelledby="download-heading">
        <div>
          <h2 id="download-heading">Keep the clean result close.</h2>
          <p>
            One shortcut, one selection, and a useful clipboard result without sending the screen anywhere else.
          </p>
        </div>
        <p class="download-note">Free, open source, and built for the Mac already in front of you.</p>
      </section>
    </main>

    <footer class="page-footer">
      <p>Created by <a href={`mailto:${site.email}`}>Bennett Hilberg</a>.</p>
      <nav aria-label="Footer links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.githubUrl} target="_blank" rel="noreferrer">View source on GitHub</a>
        <span>MIT licensed</span>
      </nav>
    </footer>
  </div>
</SiteLayout>

<style>
  .clipboard-page {
    --page-line: oklch(85% 0.028 250);
    --page-line-strong: oklch(70% 0.05 250);
    --page-ink: oklch(20% 0.035 250);
    --page-ink-soft: oklch(39% 0.038 250);
    --page-blue: oklch(53% 0.19 255);
    --page-blue-deep: oklch(29% 0.12 255);
    --page-blue-pale: oklch(93% 0.045 255);
    --page-blue-wash: oklch(97% 0.018 255);
    --page-paper: oklch(99.3% 0.006 245);
    --page-paper-deep: oklch(95.3% 0.018 245);
    min-height: 100vh;
    overflow-x: clip;
    background: var(--paper);
    color: var(--page-ink);
  }

  .page-header,
  .hero-section,
  .content-section,
  .download-section,
  .page-footer {
    width: min(calc(100% - 2rem), 74rem);
    margin-inline: auto;
  }

  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 5.75rem 1.5rem;
    border-bottom: 1px solid var(--page-line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: 0.6rem;
    color: var(--page-ink);
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
  }

  .brand:hover {
    color: var(--page-ink);
  }

  .brand-mark {
    position: relative;
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    border: 2px solid var(--page-blue);
    border-radius: 50%;
  }

  .brand-mark::after {
    position: absolute;
    right: -0.28rem;
    bottom: -0.16rem;
    width: 0.48rem;
    height: 2px;
    background: var(--page-blue);
    content: "";
    transform: rotate(45deg);
    transform-origin: left center;
  }

  .page-nav,
  .page-footer nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.7rem 1.35rem;
    color: var(--page-ink-soft);
    font-size: 0.9rem;
  }

  .page-nav a,
  .page-footer a {
    text-decoration: none;
  }

  .hero-section {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(2.5rem, 6vw, 6.5rem);
    align-items: center;
    padding-block: clamp(5rem, 10vw, 8.5rem) clamp(5.5rem, 11vw, 9.5rem);
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-copy h1 {
    max-width: 8ch;
    margin: 0;
    color: var(--page-ink);
    font-size: clamp(3.25rem, 6.4vw, 6.1rem);
    font-weight: 400;
    line-height: 0.92;
  }

  .hero-lede {
    max-width: 32rem;
    margin: 1.75rem 0 0;
    color: var(--page-ink-soft);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.55;
  }

  .hero-actions {
    display: grid;
    justify-items: start;
    gap: 0.9rem;
    margin-top: 2.25rem;
  }

  .download-button {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.85rem 1.05rem 0.85rem 1.15rem;
    border: 1px solid var(--page-blue);
    border-radius: var(--r-control);
    background: var(--page-blue);
    color: var(--blue-white);
    font-weight: 600;
    line-height: 1.1;
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .download-button:hover {
    border-color: var(--page-blue-deep);
    background: var(--page-blue-deep);
    color: var(--blue-white);
    transform: translateY(-2px);
  }

  .download-icon {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .source-link {
    color: var(--page-blue-deep);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .hero-requirements {
    margin: 0.1rem 0 0;
    color: var(--page-ink-soft);
    font-size: 0.92rem;
  }

  .hero-visual {
    position: relative;
    min-width: 0;
    min-height: clamp(31rem, 48vw, 37rem);
    margin: 0;
  }

  .source-window {
    position: absolute;
    top: 0;
    right: 0;
    width: min(100%, 36rem);
    overflow: hidden;
    border: 1px solid var(--page-line-strong);
    border-radius: var(--r-surface);
    background: var(--page-paper);
  }

  .source-window-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.15rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--page-line);
    color: var(--page-ink);
    font-size: 0.86rem;
  }

  .source-window-context {
    color: var(--page-ink-soft);
  }

  .source-window-body {
    display: grid;
    grid-template-columns: 8.8rem minmax(0, 1fr);
    min-height: 21.25rem;
  }

  .source-sidebar {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: 1.15rem 0.85rem;
    border-right: 1px solid var(--page-line);
    background: var(--page-paper-deep);
    color: var(--page-ink-soft);
    font-size: 0.82rem;
  }

  .sidebar-heading {
    color: var(--page-ink);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .sidebar-heading-spaced {
    margin-top: 0.8rem;
  }

  .sidebar-item {
    min-width: 0;
    overflow: hidden;
    padding: 0.35rem 0.45rem;
    border-radius: 5px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar-item-active {
    background: var(--page-blue-pale);
    color: var(--page-blue-deep);
    font-weight: 600;
  }

  .source-thread {
    position: relative;
    min-width: 0;
    padding: 1.2rem 1.2rem 1rem;
  }

  .thread-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--page-line);
    color: var(--page-ink-soft);
    font-size: 0.82rem;
  }

  .thread-heading strong {
    color: var(--page-ink);
    font-size: 1rem;
  }

  .chat-message {
    display: flex;
    gap: 0.7rem;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid var(--page-line);
  }

  .message-avatar {
    display: grid;
    width: 1.85rem;
    height: 1.85rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    background: var(--page-paper-deep);
    color: var(--page-ink-soft);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .message-avatar-blue {
    background: var(--page-blue-pale);
    color: var(--page-blue-deep);
  }

  .message-content {
    min-width: 0;
  }

  .message-content strong {
    display: block;
    color: var(--page-ink);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .message-content p {
    margin: 0.22rem 0 0;
    color: var(--page-ink-soft);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .chat-message-muted {
    opacity: 0.65;
  }

  .source-selection {
    position: absolute;
    inset: 6.35rem 1rem 2.25rem 0.7rem;
    border: 2px solid var(--page-blue);
    background: rgb(42 111 214 / 0.04);
    clip-path: inset(0);
  }

  .selection-label {
    position: absolute;
    top: -1.05rem;
    left: -2px;
    padding: 0.22rem 0.42rem;
    background: var(--page-blue);
    color: var(--blue-white);
    font-size: 0.8rem;
    line-height: 1.2;
  }

  .clipboard-sheet {
    position: absolute;
    z-index: 2;
    bottom: 0;
    left: 0;
    width: min(84%, 31rem);
    min-height: 23rem;
    padding: 2.45rem clamp(1.35rem, 3vw, 2.2rem) 1.5rem;
    border: 1px solid var(--page-line-strong);
    background: var(--page-paper);
    box-shadow: 0.75rem 0.85rem 0 var(--page-blue-pale);
    transform: rotate(-2deg);
  }

  .clipboard-clip {
    position: absolute;
    top: -0.9rem;
    left: 50%;
    width: 6.2rem;
    height: 2rem;
    border: 1px solid var(--page-line-strong);
    border-bottom: 0;
    border-radius: 0.65rem 0.65rem 0 0;
    background: var(--page-paper);
    transform: translateX(-50%);
  }

  .clipboard-clip::after {
    position: absolute;
    right: 0.75rem;
    bottom: 0.35rem;
    left: 0.75rem;
    height: 0.35rem;
    border: 1px solid var(--page-line-strong);
    border-radius: 0.2rem;
    content: "";
  }

  .clipboard-sheet-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--page-ink-soft);
    font-size: 0.88rem;
  }

  .clipboard-sheet-header span:first-child {
    color: var(--page-ink);
    font-weight: 600;
  }

  .clipboard-sheet-rule {
    height: 1px;
    margin-top: 1rem;
    background: var(--page-line);
  }

  .clipboard-copy {
    max-width: 24rem;
    margin-top: 2.2rem;
    color: var(--page-ink);
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    font-weight: 400;
    line-height: 1.22;
  }

  .clipboard-copy p {
    margin: 0;
  }

  .clipboard-copy p + p {
    margin-top: 0.35rem;
  }

  .clipboard-confirmation {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 2.2rem;
    padding: 0.75rem 0.85rem;
    background: var(--page-blue-pale);
    color: var(--page-blue-deep);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .confirmation-check {
    display: grid;
    width: 1.35rem;
    height: 1.35rem;
    place-items: center;
    border-radius: 50%;
    background: var(--page-blue);
    color: var(--blue-white);
    font-size: 0.9rem;
    line-height: 1;
  }

  .content-section {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    border-top: 1px solid var(--page-line);
  }

  .section-intro {
    max-width: 40rem;
  }

  .section-intro h2,
  .download-section h2 {
    max-width: 16ch;
    margin: 0 0 1rem;
    color: var(--page-ink);
    font-size: clamp(2.25rem, 4.5vw, 4rem);
    font-weight: 400;
    line-height: 0.98;
  }

  .section-intro p,
  .download-section p {
    max-width: 39rem;
    margin: 0;
    color: var(--page-ink-soft);
    font-size: 1rem;
  }

  .process-section {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    align-items: start;
  }

  .process-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--page-line-strong);
  }

  .process-step {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--page-line);
  }

  .process-step-key {
    padding-top: 0.1rem;
    color: var(--page-blue-deep);
    font-size: 1rem;
  }

  .process-step kbd {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    padding: 0.3rem 0.45rem;
    border: 1px solid var(--page-line-strong);
    border-radius: 5px;
    background: var(--page-blue-wash);
    color: var(--page-blue-deep);
    font: inherit;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .process-step h3,
  .proof-item h3 {
    margin: 0;
    color: var(--page-ink);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .process-step p,
  .proof-item p {
    margin: 0.4rem 0 0;
    color: var(--page-ink-soft);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .proof-section {
    background: var(--page-blue-wash);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin-top: 3rem;
  }

  .proof-item {
    min-width: 0;
    padding-top: 1.25rem;
    border-top: 2px solid var(--page-blue);
  }

  .language-sample,
  .code-sample,
  .qr-sample {
    min-height: 10.5rem;
    margin-bottom: 1.35rem;
    border: 1px solid var(--page-line-strong);
    background: var(--page-paper);
  }

  .language-sample {
    display: grid;
    align-content: center;
    gap: 0.45rem;
    padding: 1.1rem;
    color: var(--page-ink);
