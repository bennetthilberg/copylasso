---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { compatibilityFacts, privacyFacts, site } from "../../data/site";

const pageDescription =
  "Quiet Catalog is a visual catalog of the text, scripts, codes, and screen fragments CopyLasso can read locally on macOS.";
---

<SiteLayout
  title="Quiet Catalog · CopyLasso"
  description={pageDescription}
  optionNumber={9}
  optionName="Quiet Catalog"
  previousHref="/design-options/option-8/"
  nextHref="/design-options/option-10/"
>
  <div class="catalog-page">
    <header class="catalog-header">
      <div class="catalog-width catalog-header-inner">
        <a class="catalog-brand" href="/" aria-label="CopyLasso home">CopyLasso</a>
        <nav class="catalog-header-nav" aria-label="Page links">
          <a href="#catalog">What it reads</a>
          <a href="#how-it-works">How it works</a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <section class="catalog-hero catalog-width" aria-labelledby="hero-title">
        <div class="catalog-hero-copy">
          <h1 id="hero-title">Copy anything on your screen.</h1>
          <p class="catalog-hero-lede">
            Select a visible region and CopyLasso turns the pixels into plain text on your clipboard. It is a
            small local utility for the words, codes, and scripts already in front of you.
          </p>

          <div class="catalog-hero-actions">
            <a class="button catalog-download" href={site.downloadHref}>
              <span>{site.downloadLabel}</span>
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M10 2.75v8.4m0 0 3.1-3.1M10 11.15l-3.1-3.1M3.25 12.35v3.1c0 .83.67 1.5 1.5 1.5h10.5c.83 0 1.5-.67 1.5-1.5v-3.1"></path>
              </svg>
            </a>
            <a class="catalog-source" href={site.githubUrl} target="_blank" rel="noreferrer">
              View source on GitHub
            </a>
          </div>

          <p class="catalog-requirements">{site.requirements}</p>
        </div>

        <div class="catalog-hero-visual" aria-hidden="true">
          <div class="catalog-stage">
            <div class="catalog-source-window">
              <div class="catalog-window-topline">
                <span>Saturday market route</span>
                <span>Notes</span>
              </div>
              <div class="catalog-document">
                <p class="catalog-document-title">A walk through the city</p>
                <p class="catalog-document-copy">
                  Start at the north entrance, then follow the river path until the old station comes into view.
                </p>
                <div class="catalog-document-lines">
                  <span></span>
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>
              <div class="catalog-selection"></div>
            </div>

            <div class="catalog-result">
              <p class="catalog-result-copy">Start at the north entrance, then follow the river path.</p>
              <p class="catalog-result-state">Copied to clipboard</p>
            </div>
          </div>
          <p class="catalog-visual-caption">A crop from a visible document becomes plain text.</p>
        </div>
      </section>

      <section id="catalog" class="catalog-section catalog-width" aria-labelledby="catalog-title">
        <div class="catalog-section-heading">
          <h2 id="catalog-title">A catalog of what is already on screen.</h2>
          <p>
            The source can be a page, a message, a street sign, or a code. The result keeps the useful content and
            leaves the rest of the interface behind.
          </p>
        </div>

        <div class="catalog-specimens">
          <article class="catalog-specimen catalog-specimen-qr">
            <div class="catalog-specimen-copy">
              <h3>QR and barcodes</h3>
              <p>Recognize supported codes and put their payload on the clipboard as plain text.</p>
            </div>
            <div class="catalog-specimen-art catalog-qr-art" aria-hidden="true">
              <svg class="catalog-qr" viewBox="0 0 180 180" focusable="false">
                <rect width="180" height="180" fill="var(--paper)"></rect>
                <path
                  fill="var(--ink)"
                  d="M8 8h50v50H8zM18 18h30v30H18zM28 28h10v10H28zM122 8h50v50h-50zM132 18h30v30h-30zM142 28h10v10h-10zM8 122h50v50H8zM18 132h30v30H18zM28 142h10v10H28zM72 8h10v18H72zM90 8h12v10H90zM72 34h20v10H72zM106 8h10v30h-10zM68 54h12v12H68zM90 52h10v24H90zM108 52h18v10h-18zM136 72h18v10h-18zM162 72h10v18h-10zM68 76h14v10H68zM88 84h12v12H88zM108 76h10v26h-10zM124 92h16v10h-16zM146 94h12v12h-12zM68 106h20v10H68zM96 106h10v16H96zM114 110h12v12h-12zM134 108h10v22h-10zM152 116h20v10h-20zM70 132h12v20H70zM90 130h18v10H90zM110 136h10v28h-10zM126 132h24v10h-24zM156 140h16v12h-16zM88 154h14v18H88zM124 154h10v18h-10z"
                ></path>
              </svg>
              <p class="catalog-qr-result">copylasso.local</p>
            </div>
          </article>

          <article class="catalog-specimen catalog-specimen-scripts">
            <div class="catalog-specimen-copy">
              <h3>Multiple scripts</h3>
              <p>Choose and prioritize the languages available to Apple Vision on your Mac.</p>
            </div>
            <div class="catalog-specimen-art catalog-scripts-art" aria-hidden="true">
              <p>Text you can read.</p>
              <p>Texte que vous pouvez lire.</p>
              <p>見えている文字を読む。</p>
              <p dir="rtl">اقرأ ما يظهر أمامك.</p>
            </div>
          </article>

          <article class="catalog-specimen catalog-specimen-code">
            <div class="catalog-specimen-copy">
              <h3>Code characters</h3>
              <p>Keep punctuation, paths, and the small details that make technical text useful.</p>
            </div>
            <div class="catalog-specimen-art catalog-code-art" aria-hidden="true">
              <div class="catalog-code-line"><span>let</span> visible = <em>"text"</em>;</div>
              <div class="catalog-code-line"><span>copy</span>(visible);</div>
              <div class="catalog-code-line"><span>return</span> clipboard;</div>
            </div>
          </article>

          <article class="catalog-specimen catalog-specimen-screen">
            <div class="catalog-specimen-copy">
              <h3>Screen text</h3>
              <p>Pull a useful sentence from a message, a photo, or any readable part of a visible app.</p>
            </div>
            <div class="catalog-specimen-art catalog-screen-art" aria-hidden="true">
              <div class="catalog-message-window">
                <p class="catalog-message-title">Project notes</p>
                <p class="catalog-message-copy">The text was already there. Now it is ready to paste.</p>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section id="how-it-works" class="catalog-workflow" aria-labelledby="workflow-title">
        <div class="catalog-width">
          <div class="catalog-section-heading catalog-workflow-heading">
            <h2 id="workflow-title">Three moves, then text.</h2>
            <p>CopyLasso keeps the path short enough to remember and clear enough to use without leaving the app.</p>
          </div>

          <ol class="catalog-workflow-list">
            <li>
              <span class="catalog-step-number">1</span>
              <div>
                <h3>Press <kbd>⇧⌘2</kbd></h3>
                <p>Bring up the macOS capture crosshair with the configurable shortcut.</p>
              </div>
            </li>
            <li>
              <span class="catalog-step-number">2</span>
              <div>
                <h3>Select</h3>
                <p>Drag around the words, code, QR code, or barcode you can already see.</p>
              </div>
            </li>
            <li>
              <span class="catalog-step-number">3</span>
              <div>
                <h3>Copy</h3>
                <p>Apple Vision recognizes the selection locally and places plain text on your clipboard.</p>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <section class="catalog-trust catalog-width" aria-label="Privacy and compatibility">
        <section id="privacy" class="catalog-trust-block" aria-labelledby="privacy-title">
          <h2 id="privacy-title">Privacy stays inside the gesture.</h2>
          <p class="catalog-trust-intro">
            The pixels are useful because the capture is temporary. Recognition happens on your Mac, and the text
            you choose remains yours.
          </p>
          <ul class="catalog-trust-list">
            {privacyFacts.map((fact) => (
              <li>{fact}</li>
            ))}
          </ul>
        </section>

        <section id="compatibility" class="catalog-trust-block" aria-labelledby="compatibility-title">
          <h2 id="compatibility-title">Fits the Mac you already use.</h2>
          <p class="catalog-trust-intro">
            CopyLasso is a free, open-source menu-bar utility with a narrow job and no account standing between you
            and the next selection.
          </p>
          <ul class="catalog-trust-list">
            {compatibilityFacts.map((fact) => (
              <li>{fact}</li>
            ))}
          </ul>
        </section>
      </section>

      <section id="download" class="catalog-download-section" aria-labelledby="download-title">
        <div class="catalog-width catalog-download-inner">
          <h2 id="download-title">Keep the next screen copyable.</h2>
          <p>
            Start with the download above. CopyLasso stays small, local, and ready for the next piece of text you
            need to move.
          </p>
          <a class="catalog-download-source" href={site.githubUrl} target="_blank" rel="noreferrer">
            Read the MIT-licensed source
          </a>
        </div>
      </section>
    </main>

    <footer class="catalog-footer">
      <div class="catalog-width catalog-footer-inner">
        <p>Created by <a href={`mailto:${site.email}`}>Bennett Hilberg</a></p>
        <div class="catalog-footer-links">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.githubUrl} target="_blank" rel="noreferrer">View source on GitHub</a>
          <span>MIT licensed</span>
        </div>
      </div>
    </footer>
  </div>
</SiteLayout>

<style>
  .catalog-page {
    --catalog-width: 74rem;
    --catalog-rule: var(--line-strong);
    --catalog-soft-rule: var(--line);
    min-width: 0;
    overflow-x: clip;
  }

  .catalog-width {
    width: min(calc(100% - 2rem), var(--catalog-width));
    margin-inline: auto;
  }

  .catalog-header {
    padding-top: 1.35rem;
  }

  .catalog-header-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.25rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--catalog-rule);
  }

  .catalog-brand {
    color: var(--ink);
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
  }

  .catalog-header-nav,
  .catalog-footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.35rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .catalog-header-nav a,
  .catalog-footer a,
  .catalog-download-source {
    color: var(--blue-ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .catalog-header-nav a:hover,
  .catalog-footer a:hover,
  .catalog-download-source:hover {
    color: var(--blue);
  }

  .catalog-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
    padding-block: clamp(5rem, 12vw, 9rem) clamp(5rem, 9vw, 8rem);
    border-bottom: 1px solid var(--catalog-rule);
  }

  .catalog-hero-copy {
    min-width: 0;
  }

  .catalog-hero-copy h1 {
    max-width: 9ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(3.2rem, 7.2vw, 7.2rem);
    font-weight: 400;
    line-height: 0.94;
    text-wrap: balance;
  }

  .catalog-hero-lede {
    max-width: 32rem;
    margin: clamp(1.75rem, 4vw, 2.75rem) 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.08rem, 1.7vw, 1.35rem);
    line-height: 1.48;
  }

  .catalog-hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .catalog-download {
    min-height: 3.25rem;
    padding-inline: 1.15rem;
  }

  .catalog-download svg {
    width: 1.2rem;
    height: 1.2rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .catalog-source {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--blue-ink);
    font-weight: 600;
  }

  .catalog-requirements {
    margin: 1.35rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .catalog-hero-visual {
    min-width: 0;
  }

  .catalog-stage {
    position: relative;
    aspect-ratio: 1.08 / 1;
    min-height: 30rem;
    overflow: hidden;
    border: 1px solid var(--catalog-rule);
    background: var(--paper-deep);
  }

  .catalog-source-window {
    position: absolute;
    inset: 1.3rem 1.3rem 2.6rem;
    overflow: hidden;
    border: 1px solid var(--catalog-rule);
    background: var(--paper);
  }

  .catalog-window-topline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border-bottom: 1px solid var(--catalog-soft-rule);
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .catalog-document {
    max-width: 34rem;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.15rem, 4vw, 3.25rem);
  }

  .catalog-document-title {
    max-width: 12ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.8rem, 4vw, 3.5rem);
    font-weight: 400;
    line-height: 0.98;
  }

  .catalog-document-copy {
    max-width: 31rem;
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.7vw, 1.3rem);
    line-height: 1.42;
  }

  .catalog-document-lines {
    display: grid;
    gap: 0.85rem;
    max-width: 24rem;
    margin-top: 2.2rem;
  }

  .catalog-document-lines span {
    display: block;
    height: 1px;
    background: var(--line-strong);
  }

  .catalog-document-lines span:nth-child(2) {
    width: 82%;
  }

  .catalog-document-lines span:nth-child(3) {
    width: 67%;
  }

  .catalog-document-lines span:nth-child(4) {
    width: 91%;
  }

  .catalog-selection {
    position: absolute;
    inset: 31% 12% 31% 8%;
    border: 2px solid var(--blue);
    transform-origin: top left;
    animation: catalog-selection-draw 6.2s var(--ease-out) infinite;
  }

  .catalog-result {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    width: min(18rem, 48%);
    padding: 1rem 1.05rem 1.1rem;
    border: 1px solid var(--blue);
    background: var(--paper);
    animation: catalog-result-arrive 6.2s var(--ease-out) infinite;
  }

  .catalog-result-copy {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    line-height: 1.28;
  }

  .catalog-result-state {
    margin: 0.8rem 0 0;
    color: var(--blue-ink);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .catalog-visual-caption {
    max-width: 32rem;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  @keyframes catalog-selection-draw {
    0%,
    13% {
      opacity: 0;
      transform: scale(0.08);
    }

    23%,
    68% {
      opacity: 1;
      transform: scale(1);
    }

    84%,
    100% {
      opacity: 0.35;
      transform: scale(1);
    }
  }

  @keyframes catalog-result-arrive {
    0%,
    48% {
      opacity: 0;
      transform: translateY(0.75rem);
    }

    60%,
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .catalog-section {
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .catalog-section-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 5.5rem);
  }

  .catalog-section-heading h2 {
    max-width: 13ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.3rem, 4.9vw, 4.6rem);
    font-weight: 400;
    line-height: 0.98;
    text-wrap: balance;
  }

  .catalog-section-heading p {
    max-width: 35rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.5;
  }

  .catalog-specimens {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0 clamp(1.25rem, 3vw, 3.5rem);
    border-top: 1px solid var(--ink);
  }

  .catalog-specimen {
    display: flex;
    min-width: 0;
    min-height: 28rem;
    flex-direction: column;
    gap: 2rem;
    padding-block: 1.4rem clamp(2.75rem, 6vw, 5rem);
    border-bottom: 1px solid var(--catalog-rule);
  }

  .catalog-specimen-qr,
  .catalog-specimen-screen {
    grid-column: span 5;
  }

  .catalog-specimen-scripts,
  .catalog-specimen-code {
    grid-column: span 7;
  }

  .catalog-specimen-copy h3 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.45rem, 2.3vw, 2.1rem);
    font-weight: 400;
    line-height: 1.05;
  }

  .catalog-specimen-copy p {
    max-width: 32rem;
    margin: 0.8rem 0 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.48;
  }

  .catalog-specimen-art {
    display: flex;
    min-width: 0;
    flex: 1;
    align-items: center;
  }

  .catalog-qr-art {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.1rem, 3vw, 2rem);
    background: var(--paper-deep);
  }

  .catalog-qr {
    width: min(13rem, 47%);
    height: auto;
    border: 1px solid var(--line-strong);
  }

  .catalog-qr-result {
    max-width: 10ch;
    margin: 0;
    color: var(--blue-ink);
    font-size: clamp(1.3rem, 2.8vw, 2.4rem);
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .catalog-scripts-art {
    display: grid;
    align-content: center;
    gap: clamp(0.35rem, 1vw, 0.8rem);
    min-height: 19rem;
    padding: clamp(1.3rem, 4vw, 2.8rem);
    background: var(--blue-pale);
    color: var(--blue-ink);
  }

  .catalog-scripts-art p {
    margin: 0;
    font-size: clamp(1.35rem, 3.3vw, 3.2rem);
    line-height: 1.08;
  }

  .catalog-code-art {
    display: grid;
    align-content: center;
    gap: 0.45rem;
    min-height: 19rem;
    padding: clamp(1.3rem, 4vw, 2.8rem);
    border-block: 1px solid var(--catalog-rule);
    color: var(--ink);
    font-size: clamp(1.55rem, 3.8vw, 3.8rem);
    line-height: 1.08;
    overflow-wrap: anywhere;
  }

  .catalog-code-line span,
  .catalog-code-line em {
    color: var(--blue-ink);
    font-style: normal;
  }

  .catalog-screen-art {
    min-height: 19rem;
    padding: clamp(1.1rem, 3vw, 2rem);
    background: var(--paper-deep);
  }

  .catalog-message-window {
    width: 100%;
    padding: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid var(--catalog-rule);
    background: var(--paper);
  }

  .catalog-message-title {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .catalog-message-copy {
    max-width: 22rem;
    margin: 1.75rem 0 0;
    color: var(--ink);
    font-size: clamp(1.5rem, 3.1vw, 2.8rem);
    line-height: 1.05;
  }

  .catalog-workflow {
    padding-block: clamp(5rem, 10vw, 9rem);
    border-block: 1px solid var(--catalog-rule);
    background: var(--paper-deep);
  }

  .catalog-workflow-heading {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .catalog-workflow-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .catalog-workflow-list li {
    min-width: 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--catalog-rule);
  }

  .catalog-step-number {
    display: block;
    color: var(--blue);
    font-size: 2.2rem;
    font-weight: 400;
    line-height: 1;
  }

  .catalog-workflow-list h3 {
    margin: 1.6rem 0 0;
    color: var(--ink);
    font-size: clamp(1.45rem, 2.5vw, 2.2rem);
    font-weight: 400;
    line-height: 1.05;
  }

  .catalog-workflow-list p {
    max-width: 21rem;
    margin: 0.85rem 0 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.5;
  }

  .catalog-workflow-list kbd {
    display: inline-block;
    padding: 0.18rem 0.4rem 0.22rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-control);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 0.78em;
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
  }

  .catalog-trust {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 7vw, 7rem);
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .catalog-trust-block {
    min-width: 0;
  }

  .catalog-trust-block h2 {
    max-width: 13ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(2rem, 4vw, 3.8rem);
    font-weight: 400;
    line-height: 1;
  }

  .catalog-trust-intro {
    max-width: 32rem;
    margin: 1.35rem 0 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.5;
