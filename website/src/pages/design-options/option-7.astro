---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { compatibilityFacts, features, privacyFacts, site } from "../../data/site";

const pageDescription =
  "Still Frame shows how CopyLasso reads text from an unselectable street-sign image and copies it locally.";
const qrRows = [
  "1111100101111",
  "1000101101001",
  "1010100101011",
  "1000101111001",
  "1111101011111",
  "0010010010000",
  "1101111010110",
  "0110010111001",
  "1011011100101",
  "0010110011110",
  "1111101001011",
  "1000100110100",
  "1111101011111",
];
const qrCells = qrRows.flatMap((row) => [...row]);
---

<SiteLayout
  title="Still Frame · CopyLasso"
  description={pageDescription}
  optionNumber={7}
  optionName="Still Frame"
  previousHref="/design-options/option-6/"
  nextHref="/design-options/option-8/"
>
  <div class="still-frame-page">
    <header class="still-frame-header">
      <a class="still-frame-brand" href="/" aria-label="CopyLasso home">CopyLasso</a>
      <nav class="still-frame-header-nav" aria-label="Page links">
        <a href="#how-it-works">How it works</a>
        <a href={site.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </header>

    <main id="main-content">
      <section class="still-frame-hero" aria-labelledby="still-frame-title">
        <div class="still-frame-hero-grid">
          <div class="still-frame-hero-copy">
            <h1 id="still-frame-title">Copy anything on your screen.</h1>
            <p class="still-frame-hero-lede">
              CopyLasso reads the words inside a photo, a sign, or a video frame. Select the pixels and get clean
              text on your clipboard.
            </p>

            <div class="still-frame-actions">
              <a class="button still-frame-download-action" href={site.downloadHref}>
                {site.downloadLabel}
                <svg
                  class="still-frame-download-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M12 3.25v10.5" />
                  <path d="m8 10 4 4 4-4" />
                  <path d="M4.25 16.5v3.25h15.5V16.5" />
                </svg>
              </a>
              <a class="still-frame-source" href={site.githubUrl} target="_blank" rel="noreferrer">
                View source on GitHub
              </a>
            </div>

            <p class="still-frame-meta">{site.requirements}</p>
            <p class="still-frame-shortcut">
              Press <kbd>{site.shortcut}</kbd>, select a frame, and keep moving.
            </p>
          </div>

          <figure class="still-frame-figure">
            <div class="still-frame-stage" aria-hidden="true">
              <div class="still-frame-scene">
                <div class="still-frame-cloud still-frame-cloud-a"></div>
                <div class="still-frame-cloud still-frame-cloud-b"></div>

                <div class="still-frame-building still-frame-building-left">
                  <span class="still-frame-window still-frame-window-a"></span>
                  <span class="still-frame-window still-frame-window-b"></span>
                  <span class="still-frame-window still-frame-window-c"></span>
                  <span class="still-frame-window still-frame-window-d"></span>
                  <span class="still-frame-window still-frame-window-e"></span>
                  <span class="still-frame-window still-frame-window-f"></span>
                </div>
                <div class="still-frame-building still-frame-building-right">
                  <span class="still-frame-window still-frame-window-a"></span>
                  <span class="still-frame-window still-frame-window-b"></span>
                  <span class="still-frame-window still-frame-window-c"></span>
                  <span class="still-frame-window still-frame-window-d"></span>
                </div>

                <div class="still-frame-road"></div>
                <span class="still-frame-road-mark still-frame-road-mark-a"></span>
                <span class="still-frame-road-mark still-frame-road-mark-b"></span>
                <span class="still-frame-road-mark still-frame-road-mark-c"></span>

                <span class="still-frame-pole"></span>
                <div class="still-frame-sign">
                  <span>RIVER STREET</span>
                  <span>5TH AVE</span>
                </div>

                <div class="still-frame-selection">
                  <span class="still-frame-selection-line still-frame-selection-top"></span>
                  <span class="still-frame-selection-line still-frame-selection-right"></span>
                  <span class="still-frame-selection-line still-frame-selection-bottom"></span>
                  <span class="still-frame-selection-line still-frame-selection-left"></span>
                </div>

                <div class="still-frame-result">
                  <span class="still-frame-result-copy">RIVER STREET<br />5TH AVE</span>
                  <span class="still-frame-result-status">Copied to clipboard</span>
                </div>
              </div>
            </div>
            <figcaption>
              A sign in a still image is not selectable. The blue frame makes it readable anyway.
            </figcaption>
          </figure>
        </div>
      </section>

      <section id="how-it-works" class="still-frame-section still-frame-workflow" aria-labelledby="workflow-title">
        <div class="still-frame-section-heading">
          <h2 id="workflow-title">Press, select, copy.</h2>
          <p>
            The capture moment is small enough to remember. CopyLasso keeps the path from screen pixels to plain text
            in three moves.
          </p>
        </div>

        <ol class="still-frame-steps">
          <li>
            <h3>Press <kbd>{site.shortcut}</kbd></h3>
            <p>Bring up the native capture crosshair without leaving the app you are using.</p>
          </li>
          <li>
            <h3>Select the frame</h3>
            <p>Draw around the words, code, QR pattern, or sign that you can see but cannot select.</p>
          </li>
          <li>
            <h3>Copy the result</h3>
            <p>Apple Vision recognizes the region locally and places plain text on your clipboard.</p>
          </li>
        </ol>
      </section>

      <section id="features" class="still-frame-section still-frame-proof" aria-labelledby="proof-title">
        <div class="still-frame-section-heading">
          <h2 id="proof-title">Read the whole frame.</h2>
          <p>
            A street sign is one kind of stubborn text. The same selection can catch codes and languages in the visual
            noise around it.
          </p>
        </div>

        <div class="still-frame-proof-shelf">
          <figure class="still-frame-proof-sample">
            <div class="still-frame-qr" aria-hidden="true">
              {qrCells.map((cell) => <span class={cell === "1" ? "is-on" : ""}></span>)}
            </div>
            <figcaption>
              <h3>Codes stay useful.</h3>
              <p>QR and supported barcodes become inert text instead of a second app to open.</p>
            </figcaption>
          </figure>

          <figure class="still-frame-proof-sample">
            <div class="still-frame-script-board" aria-hidden="true">
              <span class="still-frame-script-large">RIVER STREET</span>
              <span>東京駅</span>
              <span>calle del río</span>
              <span>서울로</span>
            </div>
            <figcaption>
              <h3>Languages share the frame.</h3>
              <p>Choose and prioritize the languages available to Apple Vision on your Mac.</p>
            </figcaption>
          </figure>

          <figure class="still-frame-proof-sample">
            <div class="still-frame-plain-text-board" aria-hidden="true">
              <span>RIVER STREET</span>
              <span>5TH AVE</span>
              <span>ready to paste</span>
            </div>
            <figcaption>
              <h3>The output stays plain.</h3>
              <p>CopyLasso gives you clean clipboard text, without recreating the image around it.</p>
            </figcaption>
          </figure>
        </div>

        <ul class="still-frame-feature-list">
          {features.map((feature) => (
            <li>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="privacy" class="still-frame-privacy" aria-labelledby="privacy-title">
        <div class="still-frame-wide-grid">
          <div class="still-frame-section-heading">
            <h2 id="privacy-title">The still frame stays yours.</h2>
            <p>
              CopyLasso has a narrow job and a narrow data boundary. Capture and recognition stay local, and the image
              is not kept around after the work is done.
            </p>
          </div>
          <ul class="still-frame-fact-list">
            {privacyFacts.map((fact) => <li>{fact}</li>)}
          </ul>
        </div>
      </section>

      <section id="compatibility" class="still-frame-section still-frame-compatibility" aria-labelledby="compatibility-title">
        <div class="still-frame-wide-grid">
          <div class="still-frame-section-heading">
            <h2 id="compatibility-title">Fits the Mac you already use.</h2>
            <p>
              A free, open-source utility for the menu bar. It asks for Screen Recording permission only when region
              capture needs to read the pixels on screen.
            </p>
          </div>
          <ul class="still-frame-compatibility-list">
            {compatibilityFacts.map((fact) => <li>{fact}</li>)}
          </ul>
        </div>
      </section>

      <section id="download" class="still-frame-download" aria-labelledby="download-title">
        <div class="still-frame-download-inner">
          <div>
            <h2 id="download-title">Keep the next screen local.</h2>
            <p>Free, open source, and ready for the next frame you need to read.</p>
          </div>
          <div class="still-frame-download-final">
            <p>One shortcut. One small selection.</p>
            <a class="button" href={site.downloadHref}>
              <span>{site.downloadLabel}</span>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M12 3v11"></path>
                <path d="m8.5 10.5 3.5 3.5 3.5-3.5"></path>
                <path d="M4 16.5V19a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-2.5"></path>
              </svg>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="still-frame-footer">
      <div class="still-frame-footer-inner">
        <p>Created by <a href={`mailto:${site.email}`}>Bennett Hilberg</a>.</p>
        <div class="still-frame-footer-links">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.githubUrl} target="_blank" rel="noreferrer">View source on GitHub</a>
          <span>MIT licensed.</span>
        </div>
      </div>
    </footer>
  </div>
</SiteLayout>

<style>
  .still-frame-page {
    --still-sky: oklch(93% 0.028 240);
    --still-sky-light: oklch(97% 0.014 240);
    --still-plane: oklch(87% 0.042 242);
    --still-structure: oklch(78% 0.052 242);
    --still-structure-dark: oklch(59% 0.052 244);
    --still-road: oklch(71% 0.044 244);
    --still-road-light: oklch(88% 0.034 242);
    --still-sign: oklch(98% 0.009 240);
    --still-sign-edge: oklch(34% 0.048 244);
    --still-blue-wash: oklch(94% 0.035 250);
    min-width: 0;
    overflow-x: clip;
  }

  .still-frame-header,
  .still-frame-footer-inner,
  .still-frame-wide-grid,
  .still-frame-hero-grid,
  .still-frame-section,
  .still-frame-download-inner {
    width: min(calc(100% - 2rem), var(--measure));
    margin-inline: auto;
  }

  .still-frame-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.35rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .still-frame-brand {
    color: var(--ink);
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: -0.055em;
    text-decoration: none;
  }

  .still-frame-header-nav,
  .still-frame-footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.35rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .still-frame-header-nav a,
  .still-frame-footer a {
    color: var(--blue-ink);
    font-weight: 500;
    text-decoration: none;
  }

  .still-frame-header-nav a:hover,
  .still-frame-footer a:hover {
    color: var(--blue);
  }

  .still-frame-hero {
    padding-top: clamp(5.5rem, 12vw, 9rem);
    padding-bottom: clamp(5rem, 10vw, 8rem);
  }

  .still-frame-hero-grid {
    display: grid;
    grid-template-columns: minmax(15rem, 0.74fr) minmax(0, 1.26fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
  }

  .still-frame-hero-copy {
    min-width: 0;
  }

  .still-frame-hero-copy h1 {
    max-width: 8.25ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(3.25rem, 7.4vw, 7rem);
    font-weight: 400;
    letter-spacing: -0.095em;
    line-height: 0.88;
    overflow-wrap: anywhere;
  }

  .still-frame-hero-lede {
    max-width: 34rem;
    margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.08rem, 1.6vw, 1.3rem);
    line-height: 1.5;
  }

  .still-frame-actions {
    display: grid;
    justify-items: start;
    gap: 0.85rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .still-frame-download-action {
    max-width: 100%;
  }

  .still-frame-download-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
  }

  .still-frame-source {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--blue-ink);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.24em;
  }

  .still-frame-source:hover {
    color: var(--blue);
  }

  .still-frame-meta {
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .still-frame-shortcut {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 1.35rem 0 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .still-frame-shortcut kbd,
  .still-frame-steps kbd {
    display: inline-block;
    padding: 0.2rem 0.45rem 0.24rem;
    border: 1px solid var(--line-strong);
    border-bottom-width: 2px;
    border-radius: var(--r-control);
    background: var(--paper-deep);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.92em;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
  }

  .still-frame-figure {
    min-width: 0;
    margin: 0;
  }

  .still-frame-stage {
    padding: clamp(0.75rem, 2.2vw, 1.25rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-surface);
    background: var(--paper-deep);
  }

  .still-frame-scene {
    position: relative;
    isolation: isolate;
    width: 100%;
    aspect-ratio: 1.08 / 1;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-control);
    background: var(--still-sky);
  }

  .still-frame-cloud,
  .still-frame-building,
  .still-frame-road,
  .still-frame-pole,
  .still-frame-sign,
  .still-frame-selection,
  .still-frame-result,
  .still-frame-road-mark {
    position: absolute;
  }

  .still-frame-cloud {
    z-index: 1;
    background: var(--still-sky-light);
    clip-path: polygon(0 25%, 22% 25%, 28% 0, 56% 0, 63% 25%, 100% 25%, 100% 100%, 0 100%);
  }

  .still-frame-cloud-a {
    top: 9%;
    right: 2%;
    width: 45%;
    height: 17%;
  }

  .still-frame-cloud-b {
    top: 18%;
    left: -7%;
    width: 34%;
    height: 12%;
    opacity: 0.72;
    transform: scale(0.8);
  }

  .still-frame-building {
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-content: start;
    gap: 0.55rem;
    padding: 1.15rem 0.8rem;
    background: var(--still-structure);
  }

  .still-frame-building-left {
    bottom: 22%;
    left: -7%;
    width: 38%;
    height: 47%;
    clip-path: polygon(17% 0, 100% 12%, 100% 100%, 0 100%, 0 15%);
    transform: rotate(-3deg);
  }

  .still-frame-building-right {
    right: -10%;
    bottom: 18%;
    width: 42%;
    height: 49%;
    grid-template-columns: repeat(2, 1fr);
    background: var(--still-plane);
    clip-path: polygon(0 14%, 84% 0, 100% 13%, 100% 100%, 0 100%);
    transform: rotate(3deg);
  }

  .still-frame-window {
    display: block;
    min-height: 0.9rem;
    background: var(--still-structure-dark);
    opacity: 0.68;
  }

  .still-frame-building-right .still-frame-window {
    background: var(--still-road);
    opacity: 0.62;
  }

  .still-frame-road {
    z-index: 3;
    right: -11%;
    bottom: -9%;
    width: 119%;
    height: 37%;
    background: var(--still-road);
    clip-path: polygon(0 31%, 100% 0, 100% 100%, 0 100%);
  }

  .still-frame-road-mark {
    z-index: 4;
    height: 0.32rem;
    background: var(--still-road-light);
    transform: rotate(-9deg);
  }

  .still-frame-road-mark-a {
    right: 9%;
    bottom: 14%;
    width: 19%;
  }

  .still-frame-road-mark-b {
    right: 33%;
    bottom: 20%;
    width: 13%;
  }

  .still-frame-road-mark-c {
    right: 53%;
    bottom: 26%;
    width: 8%;
  }

  .still-frame-pole {
    z-index: 4;
    top: 19%;
    left: 33%;
    width: 0.55rem;
    height: 66%;
    background: var(--still-sign-edge);
    transform: rotate(-1deg);
  }

  .still-frame-sign {
    z-index: 5;
    top: 20%;
    left: 9%;
    display: flex;
    width: 70%;
    min-height: 30%;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    padding: clamp(0.8rem, 2.5vw, 1.55rem) clamp(1rem, 3.8vw, 2.25rem);
    border: 3px solid var(--still-sign-edge);
    background: var(--still-sign);
    color: var(--still-sign-edge);
    transform: rotate(-2.6deg);
  }

  .still-frame-sign span {
    display: block;
    line-height: 0.96;
    white-space: nowrap;
  }

  .still-frame-sign span:first-child {
    font-size: clamp(1.2rem, 3.6vw, 2.3rem);
    font-weight: 500;
    letter-spacing: 0.018em;
  }

  .still-frame-sign span:last-child {
    font-size: clamp(1rem, 2.55vw, 1.45rem);
    letter-spacing: 0.025em;
  }

  .still-frame-selection {
    z-index: 6;
    top: 17%;
    left: 7%;
    width: 74%;
    height: 36%;
    transform: rotate(-2.6deg);
  }

  .still-frame-selection-line {
    position: absolute;
    display: block;
    background: var(--blue);
  }

  .still-frame-selection-top,
  .still-frame-selection-bottom {
    right: 0;
    left: 0;
    height: 2px;
    transform: scaleX(1);
    transform-origin: left center;
  }

  .still-frame-selection-top {
    top: 0;
  }

  .still-frame-selection-bottom {
    bottom: 0;
  }

  .still-frame-selection-left,
  .still-frame-selection-right {
    top: 0;
    bottom: 0;
    width: 2px;
    transform: scaleY(1);
    transform-origin: top center;
  }

  .still-frame-selection-left {
    left: 0;
  }

  .still-frame-selection-right {
    right: 0;
  }

  .still-frame-result {
    z-index: 7;
    right: 4%;
    bottom: 5%;
    width: 49%;
    padding: 0.85rem 1rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-control);
    background: var(--paper);
    transform: rotate(1.2deg);
  }

  .still-frame-result-copy {
    display: block;
    color: var(--ink);
    font-size: clamp(1rem, 2vw, 1.35rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .still-frame-result-status {
    display: block;
    margin-top: 0.55rem;
    color: var(--green);
    font-size: 0.86rem;
    font-weight: 500;
  }

  .still-frame-figure figcaption {
    max-width: 42rem;
    margin-top: 1rem;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .still-frame-section {
    padding-block: clamp(5rem, 10vw, 8rem);
  }

  .still-frame-section-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: start;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .still-frame-section-heading h2,
  .still-frame-download h2 {
    max-width: 11ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.25rem, 4.8vw, 4.65rem);
    font-weight: 400;
    letter-spacing: -0.085em;
    line-height: 0.93;
  }

  .still-frame-section-heading p,
  .still-frame-download p {
    max-width: 42rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.08rem;
    line-height: 1.55;
  }

  .still-frame-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    list-style: none;
  }

  .still-frame-steps li {
    min-width: 0;
    padding: 1.6rem clamp(0.1rem, 2.6vw, 2rem) 1.8rem 0;
  }

  .still-frame-steps li + li {
    padding-left: clamp(0.1rem, 2.6vw, 2rem);
    border-left: 1px solid var(--line);
  }

  .still-frame-steps h3,
  .still-frame-proof-sample h3,
  .still-frame-feature-list h3 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .still-frame-steps p,
  .still-frame-proof-sample p,
  .still-frame-feature-list p {
    margin: 0.8rem 0 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.55;
  }

  .still-frame-proof {
    border-top: 1px solid var(--line-strong);
  }

