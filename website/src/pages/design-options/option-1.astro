---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { compatibilityFacts, features, privacyFacts, site } from "../../data/site";

const description =
  "A quiet paper-window direction for CopyLasso, a local-first screen OCR utility that turns selected pixels into clipboard text.";

const compatibilityLabels = ["System", "Architecture", "Permission", "License"];

const qrPattern = [
  "11111100111",
  "10000110101",
  "10110100111",
  "10110111001",
  "10000101011",
  "11111110101",
  "00101100110",
  "11010011101",
  "10111100111",
  "01100110100",
  "11101011111",
];

const proofRows = [
  { type: "qr", title: features[2].title, body: features[2].body },
  { type: "scripts", title: features[3].title, body: features[3].body },
  { type: "code", title: features[0].title, body: features[0].body },
];
---

<SiteLayout
  title="Paper Window · CopyLasso"
  description={description}
  optionNumber={1}
  optionName="Paper Window"
  previousHref="/design-options/"
  nextHref="/design-options/option-2/"
>
  <main id="main-content" class="paper-window-page">
    <section class="paper-window-hero" aria-labelledby="hero-title">
      <div class="paper-hero-grid site-width">
        <div class="hero-copy">
          <h1 id="hero-title">Copy anything on your screen.</h1>
          <p class="hero-lede">
            CopyLasso turns a selected region of pixels into clean clipboard text. Keep the source app in front,
            frame what you need, and get back to the work already underway.
          </p>
          <p class="hero-shortcut">Press <kbd>{site.shortcut}</kbd>, then select and copy.</p>

          <div class="hero-actions">
            <a class="download-button" href="#download">
              <span>{site.downloadLabel}</span>
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M10 2.5v9m0 0 3.1-3.1M10 11.5 6.9 8.4M3.25 12.5v3.25c0 .69.56 1.25 1.25 1.25h11c.69 0 1.25-.56 1.25-1.25V12.5"></path>
              </svg>
            </a>
            <a class="source-link" href={site.githubUrl} target="_blank" rel="noreferrer">View source on GitHub</a>
            <p class="hero-requirements">{site.requirements}</p>
          </div>
        </div>

        <figure class="paper-demo" aria-labelledby="paper-demo-caption">
          <div class="paper-demo-stage" aria-hidden="true">
            <div class="document-window">
              <div class="document-bar">
                <strong>Q2 launch plan</strong>
                <span>visible spreadsheet</span>
              </div>

              <div class="document-body">
                <div class="sheet-heading">
                  <strong>Project notes</strong>
                  <span>current view</span>
                </div>

                <table class="spreadsheet">
                  <thead>
                    <tr>
                      <th scope="col">Item</th>
                      <th scope="col">Owner</th>
                      <th scope="col">When</th>
                      <th scope="col">Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <th scope="row">Launch note</th>
                      <td>Bennett</td>
                      <td>Today</td>
                      <td>Ready</td>
                    </tr>
                    <tr>
                      <th scope="row">Field guide</th>
                      <td>Studio</td>
                      <td>Friday</td>
                      <td>Draft</td>
                    </tr>
                    <tr>
                      <th scope="row">Copy from screen</th>
                      <td>Team</td>
                      <td>Next</td>
                      <td>Open</td>
                    </tr>
                    <tr>
                      <th scope="row">Share link</th>
                      <td>All</td>
                      <td>Later</td>
                      <td>Queued</td>
                    </tr>
                  </tbody>
                </table>

                <div class="selection-frame">
                  <span>selected region</span>
                </div>
              </div>

              <div class="document-footer">
                <span>Screen text stays temporary</span>
                <span>local capture</span>
              </div>
            </div>

            <div class="result-sheet">
              <div class="result-heading">
                <span>Clipboard result</span>
                <strong>Copied to clipboard</strong>
              </div>
              <p class="result-text">Copy from screen<br />Ready for the next app.</p>
              <span class="result-note">plain text · ready to paste</span>
            </div>
          </div>
          <figcaption id="paper-demo-caption">
            A blue selection crosses the visible sheet, then a plain-text result lands on a small paper surface.
          </figcaption>
        </figure>
      </div>
    </section>

    <section id="how-it-works" class="content-section workflow-section" aria-labelledby="workflow-title">
      <div class="workflow-layout site-width">
        <div class="section-intro">
          <h2 id="workflow-title">Three calm steps from screen to clipboard.</h2>
          <p>
            The workflow stays close to the app you are already using. There is no editor to open and no text to
            retype after the capture.
          </p>
        </div>

        <ol class="workflow-list">
          <li class="workflow-step">
            <span class="step-index" aria-hidden="true">01</span>
            <div>
              <h3>Press {site.shortcut}</h3>
              <p>Bring up the macOS selection crosshair with the shortcut, or use the menu bar.</p>
            </div>
          </li>
          <li class="workflow-step">
            <span class="step-index" aria-hidden="true">02</span>
            <div>
              <h3>Select a region</h3>
              <p>Drag around the words, QR code, or barcode that is already visible on your screen.</p>
            </div>
          </li>
          <li class="workflow-step">
            <span class="step-index" aria-hidden="true">03</span>
            <div>
              <h3>Copy the result</h3>
              <p>Apple Vision recognizes the selection locally and places plain text on your clipboard.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section id="features" class="content-section proof-section" aria-labelledby="proof-title">
      <div class="site-width">
        <div class="proof-intro">
          <h2 id="proof-title">Useful range, shown in the frame.</h2>
          <p>
            CopyLasso reads the kinds of things that are easy to see but hard to select. The proof is in the source
            material, not in a row of abstract feature icons.
          </p>
        </div>

        <div class="proof-rows">
          {proofRows.map((proof) => (
            <article class="proof-row">
              <div class:list={["proof-visual", `proof-visual-${proof.type}`]} aria-hidden="true">
                {proof.type === "qr" ? (
                  <div class="qr-code">
                    {qrPattern.map((row) => (
                      <div class="qr-row">
                        {[...row].map((cell) => <span class:list={[cell === "1" ? "qr-dark" : "qr-light"]}></span>)}
                      </div>
                    ))}
                  </div>
                ) : proof.type === "scripts" ? (
                  <div class="script-sample">
                    <span>Hello</span>
                    <span>こんにちは</span>
                    <span>مرحبا</span>
                    <span>你好</span>
                  </div>
                ) : (
                  <div class="code-sample">
                    <span>let selected = screen;</span>
                    <span>copy(selected);</span>
                    <span>local = true;</span>
                  </div>
                )}
              </div>
              <div class="proof-copy">
                <h3>{proof.title}</h3>
                <p>{proof.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="privacy" class="content-section privacy-section" aria-labelledby="privacy-title">
      <div class="privacy-layout site-width">
        <div class="section-intro">
          <h2 id="privacy-title">Private by default.</h2>
          <p>
            The capture is short-lived input. Screenshots and recognized strings stay in memory only as long as the
            workflow needs them, and the result stays on your Mac.
          </p>
        </div>

        <ul class="fact-list">
          {privacyFacts.map((fact) => <li>{fact}</li>)}
        </ul>
      </div>
    </section>

    <section id="compatibility" class="content-section compatibility-section" aria-labelledby="compatibility-title">
      <div class="compatibility-layout site-width">
        <div class="section-intro">
          <h2 id="compatibility-title">Fits the Mac already on your desk.</h2>
          <p>
            CopyLasso is a free, open-source utility. Give it Screen Recording permission for region capture, then
            keep the rest of the workflow local.
          </p>
        </div>

        <div>
          <dl class="compatibility-list">
            {compatibilityFacts.map((fact, index) => (
              <div>
                <dt>{compatibilityLabels[index]}</dt>
                <dd>{fact}</dd>
              </div>
            ))}
          </dl>
          <p class="permission-note">No account is needed to use the capture shortcut.</p>
        </div>
      </div>
    </section>

    <section id="download" class="download-section" aria-labelledby="download-title">
      <div class="download-layout site-width">
        <div>
          <h2 id="download-title">Make the next screen copyable.</h2>
          <p>Free, open source, and ready when the words you need are already in front of you.</p>
        </div>
        <div class="download-target">
          <a class="download-button download-button-secondary" href={site.downloadHref}>
            <span>{site.downloadLabel}</span>
            <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <path d="M10 2.5v9m0 0 3.1-3.1M10 11.5 6.9 8.4M3.25 12.5v3.25c0 .69.56 1.25 1.25 1.25h11c.69 0 1.25-.56 1.25-1.25V12.5"></path>
            </svg>
          </a>
          <p>Local Apple Vision OCR. No account required.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer paper-footer">
    <div class="footer-row">
      <p>Created by Bennett Hilberg</p>
      <div class="footer-links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.githubUrl} target="_blank" rel="noreferrer">View source on GitHub</a>
        <span>MIT licensed</span>
      </div>
    </div>
  </footer>
</SiteLayout>

<style>
  .paper-window-page {
    overflow-x: clip;
  }

  .paper-window-hero {
    padding-block: clamp(7rem, 13vw, 10rem) clamp(5rem, 9vw, 8rem);
    border-bottom: 1px solid var(--line-strong);
  }

  .paper-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-copy h1 {
    max-width: 9ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(3.45rem, 7vw, 6.7rem);
    font-weight: 400;
    line-height: 0.91;
  }

  .hero-lede {
    max-width: 34rem;
    margin: clamp(1.75rem, 4vw, 2.5rem) 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 1.55vw, 1.25rem);
    line-height: 1.52;
  }

  .hero-shortcut {
    margin: 1.5rem 0 0;
    color: var(--blue-ink);
    font-size: 1rem;
  }

  kbd {
    display: inline-flex;
    min-height: 1.9rem;
    align-items: center;
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--line-strong);
    border-bottom-color: var(--ink-soft);
    border-radius: 4px;
    background: var(--paper-deep);
    color: var(--ink);
    font: inherit;
    line-height: 1;
  }

  .hero-actions {
    display: grid;
    justify-items: start;
    gap: 0.7rem;
    margin-top: 2.2rem;
  }

  .download-button {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    padding: 0.8rem 1.15rem;
    border: 1px solid transparent;
    border-radius: var(--r-control);
    background: var(--blue);
    color: var(--blue-white);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .download-button svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .download-button:hover {
    background: var(--blue-deep);
    color: var(--blue-white);
    transform: translateY(-2px);
  }

  .source-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--blue-ink);
    font-weight: 600;
  }

  .source-link:hover {
    color: var(--blue);
  }

  .hero-requirements {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .paper-demo {
    min-width: 0;
    margin: 0;
  }

  .paper-demo-stage {
    position: relative;
    min-height: clamp(28rem, 47vw, 39rem);
  }

  .document-window {
    position: absolute;
    z-index: 1;
    inset: 0 3rem 2.7rem 0;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-surface);
    background: var(--blue-white);
  }

  .document-bar,
  .document-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.2rem;
    color: var(--muted);
    font-size: 0.84rem;
  }

  .document-bar {
    border-bottom: 1px solid var(--line);
  }

  .document-bar strong {
    color: var(--ink);
    font-weight: 500;
  }

  .document-footer {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    border-top: 1px solid var(--line);
    background: var(--paper);
  }

  .document-body {
    position: relative;
    padding: 1.35rem clamp(1rem, 2.5vw, 2rem) 4.6rem;
  }

  .sheet-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    color: var(--muted);
    font-size: 0.84rem;
  }

  .sheet-heading strong {
    color: var(--ink);
    font-weight: 500;
  }

  .spreadsheet {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    color: var(--ink-soft);
    font-size: 0.8rem;
    line-height: 1.35;
  }

  .spreadsheet th,
  .spreadsheet td {
    padding: 0.72rem 0.55rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
    overflow-wrap: anywhere;
  }

  .spreadsheet thead th {
    color: var(--muted);
    font-weight: 500;
  }

  .spreadsheet tbody th {
    color: var(--ink);
    font-weight: 500;
  }

  .selection-frame {
    position: absolute;
    z-index: 2;
    top: 34%;
    left: 7%;
    width: 81%;
    height: 42%;
    border: 2px solid var(--blue);
    background: rgb(65 124 231 / 0.08);
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: left center;
    animation: paper-selection 6.8s var(--ease-out) infinite;
  }

  .selection-frame span {
    position: absolute;
    top: -1.85rem;
    left: -2px;
    padding: 0.2rem 0.35rem;
    background: var(--blue);
    color: var(--blue-white);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .result-sheet {
    position: absolute;
    z-index: 3;
    right: 0;
    bottom: 0;
    width: min(17rem, 49%);
    min-height: 15rem;
    padding: 1.2rem;
    border: 1px solid var(--ink-soft);
    background: var(--paper);
    opacity: 0;
    transform: translateY(1rem) rotate(-2.2deg);
    animation: paper-result 6.8s var(--ease-out) infinite;
  }

  .result-heading {
    display: grid;
    gap: 0.42rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .result-heading span {
    color: var(--muted);
    font-size: 0.84rem;
  }

  .result-heading strong {
    color: var(--green);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .result-text {
    margin: 1.1rem 0 1.4rem;
    color: var(--ink);
    font-size: 1.03rem;
    line-height: 1.45;
  }

  .result-note {
    display: block;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.83rem;
  }

  .paper-demo figcaption {
    max-width: 39rem;
    margin: 1.25rem 0 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  @keyframes paper-selection {
    0%,
    10% {
      opacity: 0;
      transform: scaleX(0);
    }

    28%,
    100% {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @keyframes paper-result {
    0%,
    34% {
      opacity: 0;
      transform: translateY(1rem) rotate(-2.2deg);
    }

    50%,
    100% {
      opacity: 1;
      transform: translateY(0) rotate(-2.2deg);
    }
  }

  .content-section {
    padding-block: clamp(5rem, 10vw, 9rem);
    border-bottom: 1px solid var(--line-strong);
  }

  .section-intro {
    max-width: 33rem;
  }

  .section-intro h2,
  .proof-intro h2,
  .download-layout h2 {
    max-width: 15ch;
    margin: 0 0 1rem;
    color: var(--ink);
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    font-weight: 400;
    line-height: 0.97;
  }

  .section-intro p,
  .proof-intro p,
  .download-layout p {
    max-width: var(--reading);
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .workflow-layout,
  .privacy-layout,
  .compatibility-layout,
  .download-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .workflow-list,
  .fact-list,
  .compatibility-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .workflow-list {
    border-top: 1px solid var(--ink);
  }

  .workflow-step {
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1fr);
    gap: 1.35rem;
    padding: 1.65rem 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .step-index {
    padding-top: 0.2rem;
    color: var(--blue);
    font-size: 1rem;
    font-weight: 600;
  }

  .workflow-step h3,
  .proof-copy h3 {
    margin: 0 0 0.45rem;
    color: var(--ink);
    font-size: clamp(1.25rem, 2.4vw, 1.8rem);
    font-weight: 500;
    line-height: 1.05;
  }

  .workflow-step p,
  .proof-copy p {
    max-width: 42rem;
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.55;
  }

  .proof-section {
    background: var(--paper-deep);
  }

  .proof-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
  }

  .proof-rows {
    margin-top: clamp(3rem, 7vw, 6rem);
    border-top: 1px solid var(--ink);
  }

  .proof-row {
    display: grid;
    grid-template-columns: minmax(8rem, 0.38fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-block: 2rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .proof-visual {
    display: grid;
    min-height: 8rem;
    place-items: center;
    border: 1px solid var(--line-strong);
    background: var(--paper);
  }

  .qr-code {
    display: grid;
    width: 7rem;
    aspect-ratio: 1;
    gap: 1px;
    padding: 0.45rem;
    border: 1px solid var(--ink);
    background: var(--paper);
  }

  .qr-row {
    display: grid;
    grid-template-columns: repeat(11, minmax(0, 1fr));
    gap: 1px;
  }

  .qr-row span {
    min-width: 0;
  }

  .qr-dark {
    background: var(--ink);
  }

  .qr-light {
    background: var(--paper-deep);
  }

  .script-sample {
    display: grid;
    gap: 0.25rem;
    width: 100%;
    padding: 1rem;
    color: var(--blue-ink);
    font-size: clamp(0.82rem, 1.5vw, 1.05rem);
    line-height: 1.35;
  }

  .script-sample span:nth-child(2) {
    padding-left: 1rem;
  }

  .script-sample span:nth-child(3) {
    padding-left: 0.45rem;
  }

  .script-sample span:nth-child(4) {
    padding-left: 1.5rem;
  }

  .code-sample {
    display: grid;
    gap: 0.25rem;
    width: 100%;
    padding: 1rem;
    color: var(--ink);
    font-size: clamp(0.8rem, 1.4vw, 1rem);
    line-height: 1.4;
  }

  .code-sample span:nth-child(2) {
    padding-left: 1.25rem;
    color: var(--blue-ink);
  }

  .code-sample span:nth-child(3) {
    color: var(--green);
  }

  .privacy-section {
    background: var(--blue-pale);
  }

  .fact-list {
    border-top: 1px solid var(--line-strong);
  }

  .fact-list li {
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--line-strong);
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .compatibility-list {
    border-top: 1px solid var(--ink);
  }

  .compatibility-list div {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .compatibility-list dt {
    color: var(--blue-ink);
    font-weight: 600;
  }

  .compatibility-list dd {
    margin: 0;
    color: var(--ink-soft);
  }

  .permission-note {
    margin: 1.3rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .download-section {
    padding-block: clamp(4.5rem, 9vw, 7rem);
    background: var(--paper-deep);
  }

  .download-layout {
    align-items: center;
  }

  .download-target {
    display: grid;
    justify-items: start;
    gap: 0.9rem;
  }

  .download-target p {
    font-size: 0.95rem;
  }

  .download-button-secondary {
    border-color: var(--line-strong);
    background: var(--paper);
    color: var(--blue-ink);
  }

  .download-button-secondary:hover {
    border-color: var(--blue);
    background: var(--blue-pale);
    color: var(--blue-ink);
  }

