---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { compatibilityFacts, features, privacyFacts, site } from "../../data/site";

const description = "Copy visible text from any screen region with local Apple Vision OCR on your Mac.";
---

<SiteLayout
  title="Desktop Canvas · CopyLasso"
  description={description}
  optionNumber={3}
  optionName="Desktop Canvas"
  previousHref="/design-options/option-2/"
  nextHref="/design-options/option-4/"
>
  <main id="main-content" class="canvas-page">
    <section class="canvas-hero" aria-labelledby="hero-title">
      <header class="site-header canvas-header">
        <a class="brand canvas-brand" href="/design-options/">
          <span class="brand-mark" aria-hidden="true">⌁</span>
          <span>{site.name}</span>
        </a>

        <nav class="header-nav canvas-nav" aria-label="Primary">
          <a href="#how-it-works">How it works</a>
          <a href="#features">Features</a>
          <a href="#privacy">Privacy</a>
          <a href={site.githubUrl} rel="noreferrer">GitHub</a>
        </nav>
      </header>

      <div class="hero-stage site-width">
        <div class="hero-copy">
          <h1 id="hero-title">Copy text from anywhere on your screen.</h1>
          <p>
            Select a region, let Apple Vision read the pixels, and keep the useful words on your clipboard.
            CopyLasso stays local, quick, and out of the way.
          </p>

          <div class="hero-actions">
            <a class="button hero-download" href={site.downloadHref}>{site.downloadLabel}</a>
            <span class="release-meta">
              <span>{site.versionLabel}</span>
              <span>{site.requirements}</span>
            </span>
          </div>

          <p class="hero-note">Local Apple Vision OCR · No account required</p>
        </div>

        <figure class="canvas-demo" aria-labelledby="demo-caption">
          <div class="desktop-surface">
            <div class="surface-toolbar">
              <span class="surface-title">Screen selection</span>
              <span class="surface-context">CopyLasso · local</span>
            </div>

            <div class="surface-viewport">
              <div class="screen-copy" aria-hidden="true">
                <span class="screen-label">A visible note</span>
                <p class="screen-lead">The fastest path is the one you can see.</p>
                <p class="screen-detail">Keep the source app open. Copy only the words you need.</p>
              </div>

              <div class="selection-window" aria-hidden="true">
                <span class="selection-label">Selected region</span>
                <span class="selection-line">The fastest path</span>
              </div>
            </div>

            <div class="output-strip">
              <span class="output-label">Plain text on the clipboard</span>
              <p class="output-copy">The fastest path</p>
            </div>
          </div>

          <figcaption id="demo-caption">
            <strong>Select visible words.</strong>
            <span>The outlined region becomes clean text beneath the surface.</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section id="how-it-works" class="canvas-band how-band" aria-labelledby="how-title">
      <div class="band-inner">
        <header class="section-heading">
          <h2 id="how-title">Three moves from screen to clipboard.</h2>
          <p>CopyLasso works with pixels, so the source can be any app, image, video, or remote desktop.</p>
        </header>

        <ol class="process-list">
          <li>
            <span class="step-number" aria-hidden="true">01</span>
            <div>
              <h3>Press <kbd>{site.shortcut}</kbd></h3>
              <p>Use the configurable shortcut to bring up the system selection crosshair.</p>
            </div>
          </li>
          <li>
            <span class="step-number" aria-hidden="true">02</span>
            <div>
              <h3>Drag a region</h3>
              <p>Frame the words on screen. CopyLasso only needs the pixels inside your selection.</p>
            </div>
          </li>
          <li>
            <span class="step-number" aria-hidden="true">03</span>
            <div>
              <h3>Keep the words</h3>
              <p>Local Apple Vision OCR turns the selection into plain text on the clipboard.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section id="features" class="canvas-band features-band" aria-labelledby="features-title">
      <div class="band-inner feature-layout">
        <header class="section-heading">
          <h2 id="features-title">A small utility with useful edges.</h2>
          <p>Enough recognition power for the screen in front of you, without turning capture into a project.</p>
        </header>

        <ul class="feature-list">
          {features.map((feature) => (
            <li>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="privacy" class="canvas-band privacy-band" aria-labelledby="privacy-title">
      <div class="band-inner privacy-layout">
        <header class="section-heading">
          <h2 id="privacy-title">The screen stays on your Mac.</h2>
          <p>Local-first is not a footnote here. It is the boundary around the action.</p>
        </header>

        <ul class="privacy-list">
          {privacyFacts.map((fact) => (
            <li>
              <span class="privacy-mark" aria-hidden="true">✓</span>
              <span>{fact}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="compatibility" class="canvas-band compatibility-band" aria-labelledby="compatibility-title">
      <div class="band-inner compatibility-layout">
        <header class="section-heading">
          <h2 id="compatibility-title">Made for the Mac you already use.</h2>
          <p>CopyLasso is a native, open-source utility with one permission and no account setup.</p>
        </header>

        <ul class="compatibility-list">
          {compatibilityFacts.map((fact) => <li>{fact}</li>)}
        </ul>
      </div>
    </section>

    <section id="download" class="download-band" aria-labelledby="download-title">
      <div class="download-inner site-width">
        <div class="download-copy">
          <h2 id="download-title">Make the next screen copyable.</h2>
          <p>Download the free, open-source utility and keep capture where it belongs: on your Mac.</p>
        </div>

        <div class="download-actions">
          <div class="download-action-row">
            <a class="button download-button" href={site.downloadHref}>{site.downloadLabel}</a>
            <span class="release-meta download-meta">
              <span>{site.versionLabel}</span>
              <span>{site.requirements}</span>
            </span>
          </div>
          <a class="download-source" href={site.githubUrl} rel="noreferrer">View source on GitHub</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer canvas-footer">
    <div class="footer-row">
      <p>Created by Bennett Hilberg.</p>
      <div class="footer-links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.githubUrl} rel="noreferrer">View source on GitHub</a>
      </div>
    </div>
  </footer>
</SiteLayout>

<style>
  .canvas-page {
    --canvas-blue: oklch(49% 0.19 255);
    --canvas-blue-deep: oklch(29% 0.13 255);
    --canvas-blue-soft: oklch(83% 0.1 255);
    --canvas-text: oklch(98% 0.008 245);
    --canvas-muted: oklch(91% 0.035 255);
    --canvas-surface: oklch(97.5% 0.008 245);
    --canvas-surface-deep: oklch(93.5% 0.018 245);
    --canvas-ink: oklch(20% 0.035 250);
    --canvas-ink-soft: oklch(40% 0.04 250);
    --canvas-line: oklch(78% 0.03 250);
    overflow-x: clip;
  }

  .canvas-hero {
    overflow: hidden;
    background: var(--canvas-blue);
    color: var(--canvas-text);
  }

  .canvas-header {
    position: relative;
    border-bottom: 1px solid rgb(247 250 255 / 0.26);
    color: var(--canvas-text);
  }

  .canvas-header .brand,
  .canvas-header .header-nav a {
    color: var(--canvas-text);
  }

  .canvas-header .brand-mark {
    color: var(--canvas-text);
  }

  .canvas-header .header-nav {
    color: var(--canvas-muted);
  }

  .canvas-header a:hover {
    color: white;
  }

  .hero-stage {
    display: grid;
    grid-template-columns: minmax(18rem, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding-block: clamp(4.5rem, 10vw, 9rem) clamp(5.5rem, 12vw, 11rem);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .hero-copy h1 {
    max-width: 9ch;
    margin: 0;
    color: var(--canvas-text);
    font-size: clamp(3.25rem, 7.8vw, 7rem);
    font-weight: 750;
    letter-spacing: -0.09em;
    line-height: 0.88;
  }

  .hero-copy > p:not(.hero-note) {
    max-width: 34rem;
    margin: 1.8rem 0 0;
    color: var(--canvas-muted);
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: 2rem;
  }

  .hero-download,
  .download-button {
    background: var(--canvas-surface);
    color: var(--canvas-blue-deep);
  }

  .hero-download:hover,
  .download-button:hover {
    background: white;
    color: var(--canvas-blue-deep);
  }

  .release-meta {
    display: grid;
    gap: 0.2rem;
    max-width: 18rem;
    color: var(--canvas-muted);
    font-family: var(--mono);
    font-size: 0.69rem;
    letter-spacing: -0.03em;
    line-height: 1.35;
  }

  .release-meta span:first-child {
    color: var(--canvas-text);
    font-weight: 700;
  }

  .hero-note {
    margin: 1.35rem 0 0;
    color: var(--canvas-muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: -0.02em;
  }

  .canvas-demo {
    width: 100%;
    min-width: 0;
    margin: 0;
    transform: translateY(1.15rem) rotate(1.15deg);
  }

  .desktop-surface {
    overflow: hidden;
    border: 1px solid rgb(10 28 63 / 0.34);
    border-radius: var(--r-surface);
    background: var(--canvas-surface);
    color: var(--canvas-ink);
  }

  .surface-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    min-height: 3.25rem;
    padding: 0.9rem 1.15rem;
    border-bottom: 1px solid var(--canvas-line);
  }

  .surface-title {
    font-size: 0.83rem;
    font-weight: 750;
    letter-spacing: -0.02em;
  }

  .surface-context,
  .screen-label,
  .selection-label,
  .output-label {
    color: var(--canvas-ink-soft);
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: -0.03em;
  }

  .surface-context {
    overflow-wrap: anywhere;
  }

  .surface-viewport {
    position: relative;
    min-height: clamp(22rem, 35vw, 28rem);
    overflow: hidden;
    padding: clamp(1.5rem, 4vw, 3.25rem);
    background: var(--canvas-surface-deep);
  }

  .screen-copy {
    position: relative;
    z-index: 1;
    max-width: 75%;
  }

  .screen-label {
    display: block;
    margin-bottom: 0.85rem;
  }

  .screen-lead {
    max-width: 16ch;
    margin: 0;
    color: var(--canvas-ink);
    font-size: clamp(1.55rem, 3.2vw, 2.45rem);
    font-weight: 700;
    letter-spacing: -0.07em;
    line-height: 0.98;
  }

  .screen-detail {
    max-width: 29ch;
    margin: 1.25rem 0 0;
    color: var(--canvas-ink-soft);
    font-size: 0.92rem;
  }

  .selection-window {
    position: absolute;
    z-index: 2;
    top: 35%;
    left: 16%;
    display: grid;
    width: 62%;
    min-height: 7.5rem;
    align-content: end;
    gap: 0.3rem;
    padding: 0.75rem 0.9rem;
    border: 2px solid var(--canvas-blue);
    background: rgb(211 224 255 / 0.34);
    color: var(--canvas-blue-deep);
  }

  .selection-window::before,
  .selection-window::after {
    position: absolute;
    width: 0.7rem;
    height: 0.7rem;
    border: 2px solid var(--canvas-blue);
    background: var(--canvas-surface-deep);
    content: "";
  }

  .selection-window::before {
    top: -0.45rem;
    left: -0.45rem;
  }

  .selection-window::after {
    right: -0.45rem;
    bottom: -0.45rem;
  }

  .selection-label {
    color: var(--canvas-blue-deep);
  }

  .selection-line {
    font-size: clamp(1rem, 2.1vw, 1.45rem);
    font-weight: 750;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .output-strip {
    display: grid;
    grid-template-columns: minmax(8rem, 0.6fr) minmax(0, 1.4fr);
    gap: 1rem;
    align-items: baseline;
    min-height: 4.5rem;
    padding: 1rem 1.15rem;
    border-top: 2px solid var(--canvas-blue);
    background: var(--canvas-surface);
  }

  .output-copy {
    overflow-wrap: anywhere;
    margin: 0;
    color: var(--canvas-ink);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .canvas-demo figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.8rem;
    margin-top: 1.1rem;
    color: var(--canvas-muted);
    font-size: 0.79rem;
  }

  .canvas-demo figcaption strong {
    color: var(--canvas-text);
  }

  .canvas-band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 9vw, 8.5rem);
  }

  .canvas-band::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: max(1rem, calc((100vw - 72rem) / 2));
    width: 0.22rem;
    background: var(--canvas-blue);
    content: "";
  }

  .band-inner {
    display: grid;
    grid-template-columns: minmax(13rem, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(2.5rem, 7vw, 8rem);
    width: min(calc(100% - 3rem), 68rem);
    margin-left: max(2.25rem, calc((100vw - 72rem) / 2 + 2.25rem));
  }

  .section-heading {
    max-width: 28rem;
    margin: 0;
  }

  .section-heading h2 {
    max-width: 13ch;
    margin: 0 0 1rem;
    color: var(--canvas-ink);
    font-size: clamp(2rem, 4.5vw, 3.75rem);
    letter-spacing: -0.08em;
    line-height: 0.92;
  }

  .section-heading p {
    max-width: 34rem;
    margin: 0;
    color: var(--canvas-ink-soft);
  }

  .how-band {
    border-top: 1px solid var(--line);
    background: var(--paper);
  }

  .process-list,
  .feature-list,
  .privacy-list,
  .compatibility-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process-list {
    border-top: 1px solid var(--canvas-ink);
  }

  .process-list li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1.4rem 0 1.6rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .step-number {
    color: var(--canvas-blue);
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .process-list h3,
  .feature-list h3 {
    margin: 0;
    color: var(--canvas-ink);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .process-list p,
  .feature-list p {
    max-width: 42rem;
    margin: 0.55rem 0 0;
    color: var(--canvas-ink-soft);
  }

  kbd {
    display: inline-block;
    padding: 0.2rem 0.35rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-control);
    background: var(--paper-deep);
    color: var(--canvas-blue-deep);
    font-family: var(--mono);
    font-size: 0.78em;
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
    vertical-align: 0.08em;
  }

  .features-band {
    background: var(--paper-deep);
  }

  .feature-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--canvas-ink);
  }

  .feature-list li {
    min-width: 0;
    padding: 1.35rem 1.5rem 1.6rem 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .feature-list li:nth-child(even) {
    padding-right: 0;
    padding-left: 1.5rem;
    border-left: 1px solid var(--line-strong);
  }

  .privacy-band {
    background: var(--canvas-blue-deep);
    color: var(--canvas-text);
  }

  .privacy-band::before {
    background: var(--canvas-blue-soft);
  }

  .privacy-band .section-heading h2 {
    color: var(--canvas-text);
  }

  .privacy-band .section-heading p {
    color: var(--canvas-muted);
  }

  .privacy-list {
    border-top: 1px solid rgb(247 250 255 / 0.38);
  }

  .privacy-list li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding: 1.25rem 0 1.4rem;
    border-bottom: 1px solid rgb(247 250 255 / 0.22);
    color: var(--canvas-text);
  }

  .privacy-mark {
    color: var(--canvas-blue-soft);
    font-family: var(--mono);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .compatibility-band {
    background: var(--paper);
  }

  .compatibility-list {
    border-top: 1px solid var(--canvas-ink);
  }

  .compatibility-list li {
    padding: 1.15rem 0 1.25rem;
    border-bottom: 1px solid var(--line-strong);
    color: var(--canvas-ink);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .download-band {
    overflow: hidden;
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--canvas-blue);
    color: var(--canvas-text);
  }

  .download-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr);
    gap: 2rem 5rem;
    align-items: end;
  }

  .download-copy h2 {
    max-width: 10ch;
    margin: 0;
    color: var(--canvas-text);
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    letter-spacing: -0.09em;
    line-height: 0.9;
  }

  .download-copy p {
    max-width: 34rem;
    margin: 1.25rem 0 0;
    color: var(--canvas-muted);
  }

  .download-actions {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
  }

  .download-action-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
  }

  .download-meta {
    color: var(--canvas-muted);
  }

  .download-meta span:first-child {
    color: var(--canvas-text);
  }

  .download-source {
    color: var(--canvas-text);
    font-weight: 700;
  }

  .download-source:hover {
    color: white;
  }

  .canvas-footer {
    background: var(--paper);
  }

  .canvas-footer a {
    overflow-wrap: anywhere;
  }

  @media (max-width: 62rem) {
    .hero-stage {
      grid-template-columns: minmax(16rem, 0.76fr) minmax(0, 1.24fr);
      gap: 2.5rem;
    }

    .hero-copy h1 {
      font-size: clamp(3rem, 7.8vw, 5.5rem);
    }

    .band-inner {
      gap: 3rem;
    }
  }

  @media (max-width: 52rem) {
    .hero-stage,
    .band-inner,
    .download-inner {
      grid-template-columns: 1fr;
    }

    .hero-stage {
      gap: 4rem;
    }

    .hero-copy h1 {
      max-width: 10ch;
    }

    .canvas-demo {
      width: min(100%, 48rem);
      justify-self: end;
    }

    .band-inner {
      gap: 2.5rem;
    }

    .download-inner {
      align-items: start;
    }
  }

  @media (max-width: 44rem) {
    .canvas-header {
      align-items: center;
    }

    .canvas-header .header-nav a:not(.button) {
      display: none;
    }

    .hero-stage {
      display: flex;
      flex-direction: column;
      gap: 3rem;
      padding-block: 2.5rem 5.5rem;
    }

    .canvas-demo {
      order: -1;
      transform: none;
    }

    .surface-viewport {
      min-height: 18rem;
      padding: 1.35rem;
    }

    .screen-copy {
      max-width: 84%;
    }

    .screen-lead {
      font-size: clamp(1.45rem, 8vw, 2.25rem);
    }

    .selection-window {
      top: 35%;
      left: 10%;
      width: 80%;
      min-height: 6.3rem;
    }

    .output-strip {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }

    .hero-copy h1 {
      max-width: 9ch;
      font-size: clamp(2.85rem, 14vw, 4.45rem);
    }

    .hero-copy > p:not(.hero-note) {
      font-size: 1.05rem;
    }

    .hero-actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .release-meta {
      max-width: 100%;
    }

    .canvas-band {
      padding-block: 4rem 5rem;
    }

    .canvas-band::before {
      left: 1rem;
      width: 0.18rem;
    }

    .band-inner {
      width: calc(100% - 3rem);
      margin-left: 2.25rem;
    }

    .section-heading h2 {
      max-width: 12ch;
      font-size: clamp(2rem, 12vw, 3.25rem);
    }

    .feature-list {
      grid-template-columns: 1fr;
    }

    .feature-list li,
    .feature-list li:nth-child(even) {
      padding: 1.25rem 0 1.4rem;
      border-left: 0;
    }

    .download-inner {
      width: calc(100% - 2rem);
    }

    .download-copy h2 {
      font-size: clamp(2.7rem, 14vw, 4.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .canvas-page,
    .canvas-page *,
    .canvas-page *::before,
    .canvas-page *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
