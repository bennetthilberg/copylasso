---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { compatibilityFacts, privacyFacts, site } from "../../data/site";

const pageDescription =
  "One Gesture is a quiet CopyLasso landing-page direction that shows a screen selection becoming plain clipboard text on macOS.";

const qrPattern = [
  "1111111",
  "1000001",
  "1011101",
  "1010101",
  "1011101",
  "1000001",
  "1111111",
].join("").split("");
---

<SiteLayout
  title="One Gesture · CopyLasso"
  description={pageDescription}
  optionNumber={10}
  optionName="One Gesture"
  previousHref="/design-options/option-9/"
  nextHref="/design-options/"
>
  <div class="one-gesture-page">
    <header class="one-gesture-header">
      <a class="one-gesture-brand" href="/" aria-label="CopyLasso home">
        <span class="one-gesture-brand-copy">Copy</span><span>Lasso</span>
      </a>
    </header>

    <main id="main-content">
      <section class="one-gesture-hero" aria-labelledby="hero-title">
        <div class="one-gesture-intro">
          <div class="one-gesture-copy">
            <h1 id="hero-title">Copy anything <span>on your screen.</span></h1>
            <p class="one-gesture-lede">
              Select a rectangle. CopyLasso reads the pixels on your Mac and puts the result in the clipboard,
              ready for the app already in front.
            </p>
          </div>

          <div id="download" class="one-gesture-actions">
            <a class="button one-gesture-download" href={site.downloadHref}>
              <span>{site.downloadLabel}</span>
              <svg
                class="download-icon"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M12 3v11" />
                <path d="m7.5 10 4.5 4.5 4.5-4.5" />
                <path d="M4 15.5v3a1.5 1.5 0 0 0 1.5 1.5h13a1.5 1.5 0 0 0 1.5-1.5v-3" />
              </svg>
            </a>
            <a class="one-gesture-source" href={site.githubUrl} target="_blank" rel="noreferrer">
              View source on GitHub
            </a>
            <p class="one-gesture-requirements">{site.requirements}</p>
          </div>
        </div>

        <p class="sr-only">
          The demonstration shows a blue selection rectangle drawn over visible notes, followed by plain text marked
          Copied to clipboard.
        </p>

        <figure class="gesture-figure" aria-hidden="true">
          <div class="gesture-stage">
            <div class="source-window">
              <div class="source-toolbar">
                <span>Notes</span>
                <span>Weekend itinerary</span>
              </div>
              <div class="source-body">
                <div class="source-document">
                  <div class="source-document-heading">
                    <div>
                      <h2>Weekend in Montreal</h2>
                      <p>Saturday · 09:30 to 18:00</p>
                    </div>
                    <span class="source-document-count">4 stops</span>
                  </div>

                  <div class="source-table">
                    <div class="source-row">
                      <span>09:30</span>
                      <span>Marché Jean-Talon</span>
                      <span>North end</span>
                    </div>
                    <div class="source-row">
                      <span>12:15</span>
                      <span>Walk the canal</span>
                      <span>Bring a camera</span>
                    </div>
                    <div class="source-row">
                      <span>14:40</span>
                      <span>Rue Saint-Paul</span>
                      <span>Old Montréal</span>
                    </div>
                    <div class="source-row">
                      <span>17:00</span>
                      <span>Ask for directions in French</span>
                      <span>Before dinner</span>
                    </div>
                  </div>

                  <p class="source-note">A small list for a full afternoon outside.</p>
                </div>

                <div class="selection-box">
                  <span class="selection-edge selection-edge-top"></span>
                  <span class="selection-edge selection-edge-right"></span>
                  <span class="selection-edge selection-edge-bottom"></span>
                  <span class="selection-edge selection-edge-left"></span>
                </div>
              </div>
            </div>

            <div class="clipboard-sheet">
              <div class="clipboard-topline">
                <span>Clipboard</span>
                <span class="clipboard-status">Copied to clipboard</span>
              </div>
              <div class="clipboard-body">
                <p class="clipboard-result">
                  Marché Jean-Talon<br />
                  Walk the canal<br />
                  Rue Saint-Paul
                </p>
                <p class="clipboard-note">Plain text, ready to paste.</p>
              </div>
            </div>
          </div>
          <figcaption class="gesture-caption">A visible region becomes plain text in one gesture.</figcaption>
        </figure>
      </section>

      <section id="how-it-works" class="workflow-section" aria-labelledby="workflow-title">
        <div class="section-intro">
          <h2 id="workflow-title">How it works</h2>
          <p>One shortcut, one selection, one clean result.</p>
        </div>

        <ol class="workflow-line">
          <li>
            <kbd aria-label="Shift Command 2">{site.shortcut}</kbd>
            <span>start</span>
          </li>
          <li>
            <strong>select</strong>
            <span>draw over what you see</span>
          </li>
          <li>
            <strong>copy</strong>
            <span>paste the plain text</span>
          </li>
        </ol>
      </section>

      <section class="proof-section" aria-labelledby="proof-title">
        <div class="section-intro proof-intro">
          <h2 id="proof-title">The useful range is visible.</h2>
          <p>Text, codes, and scripts can all start as pixels and end up where you need them.</p>
        </div>

        <div class="proof-row">
          <article class="proof-item">
            <div class="qr-visual" role="img" aria-label="QR-like code example">
              {qrPattern.map((cell) => <span class:list={[cell === "1" ? "qr-cell-on" : "qr-cell-off"]}></span>)}
            </div>
            <h3>Codes become text.</h3>
            <p>QR and barcode recognition is part of the same selection.</p>
          </article>

          <article class="proof-item">
            <div class="script-visual" aria-hidden="true">
              <span>Bonjour</span>
              <span>こんにちは</span>
              <span>Привет</span>
              <span>العربية</span>
            </div>
            <h3>Languages stay readable.</h3>
            <p>Choose and prioritize the languages available on your Mac.</p>
          </article>

          <article class="proof-item">
            <div class="code-visual" aria-hidden="true">
              <span>const text =</span>
              <strong>"copied"</strong>
              <span>;</span>
            </div>
            <h3>Code keeps its shape.</h3>
            <p>Copy visible code characters without retyping a single line.</p>
          </article>
        </div>
      </section>

      <section id="privacy" class="details-section" aria-labelledby="privacy-title">
        <div class="details-grid">
          <div class="details-column">
            <h2 id="privacy-title">Local by default.</h2>
            <p>CopyLasso has a narrow job and a narrow data boundary.</p>
            <ul class="plain-list">
              {privacyFacts.map((fact) => <li>{fact}</li>)}
            </ul>
          </div>

          <div id="compatibility" class="details-column" aria-labelledby="compatibility-title">
            <h2 id="compatibility-title">Works with your Mac.</h2>
            <p>Free, open source, and made for the screen already in front of you.</p>
            <ul class="plain-list">
              {compatibilityFacts.map((fact) => <li>{fact}</li>)}
            </ul>
          </div>
        </div>
      </section>
    </main>

    <footer class="one-gesture-footer">
      <p>Created by <a href={`mailto:${site.email}`}>Bennett Hilberg</a>.</p>
      <div class="footer-links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.githubUrl} target="_blank" rel="noreferrer">View source on GitHub</a>
        <span>MIT licensed.</span>
      </div>
    </footer>
  </div>
</SiteLayout>

<style>
  .one-gesture-page {
    --one-gesture-width: 76rem;
    min-width: 0;
    overflow-x: clip;
    padding-bottom: 2rem;
  }

  .one-gesture-header,
  .one-gesture-hero,
  .workflow-section,
  .proof-section,
  .details-section,
  .one-gesture-footer {
    width: min(calc(100% - 2rem), var(--one-gesture-width));
    margin-inline: auto;
  }

  .one-gesture-header {
    padding-top: clamp(5rem, 9vw, 7rem);
  }

  .one-gesture-brand {
    display: inline-flex;
    align-items: baseline;
    color: var(--ink);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.055em;
    text-decoration: none;
  }

  .one-gesture-brand:hover {
    color: var(--ink);
  }

  .one-gesture-brand-copy {
    position: relative;
  }

  .one-gesture-brand-copy::after {
    position: absolute;
    right: -0.04em;
    bottom: -0.2em;
    left: -0.04em;
    height: 0.25em;
    border-bottom: 2px solid var(--blue);
    border-radius: 0 0 70% 35%;
    content: "";
    transform: rotate(-2deg);
  }

  .one-gesture-hero {
    padding-block: clamp(4.75rem, 11vw, 9rem) clamp(5rem, 12vw, 10rem);
  }

  .one-gesture-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.53fr);
    gap: clamp(3rem, 11vw, 12rem);
    align-items: end;
  }

  .one-gesture-copy h1 {
    max-width: 11ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(3.25rem, 9.4vw, 8.5rem);
    font-weight: 400;
    letter-spacing: -0.095em;
    line-height: 0.88;
    overflow-wrap: anywhere;
  }

  .one-gesture-copy h1 span {
    display: inline;
  }

  .one-gesture-lede {
    max-width: 32rem;
    margin: clamp(1.8rem, 3vw, 2.6rem) 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.1rem, 1.8vw, 1.25rem);
    line-height: 1.52;
  }

  .one-gesture-actions {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
  }

  .one-gesture-download {
    min-height: 3.25rem;
    gap: 0.7rem;
    padding-inline: 1.15rem;
  }

  .one-gesture-download .download-icon {
    flex: 0 0 auto;
  }

  .one-gesture-source {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-top: 0.45rem;
    color: var(--blue-ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .one-gesture-source:hover {
    color: var(--blue);
  }

  .one-gesture-requirements {
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .gesture-figure {
    margin: clamp(4rem, 9vw, 8.5rem) 0 0;
  }

  .gesture-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(16rem, 0.62fr);
    gap: clamp(1rem, 4vw, 4rem);
    align-items: stretch;
    padding-block: clamp(1.25rem, 3vw, 2.25rem);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .source-window {
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-surface);
    background: var(--paper-deep);
  }

  .source-toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--line-strong);
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .source-body {
    position: relative;
    min-height: clamp(19rem, 36vw, 28rem);
    padding: clamp(1.25rem, 4vw, 3rem);
    background: var(--paper);
  }

  .source-document {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .source-document-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .source-document-heading h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.35rem, 3vw, 2.35rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .source-document-heading p,
  .source-document-count {
    margin: 0.55rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .source-document-count {
    flex: 0 0 auto;
    margin-top: 0.15rem;
    color: var(--blue-ink);
  }

  .source-table {
    margin-top: clamp(2rem, 5vw, 4rem);
    border-top: 1px solid var(--line-strong);
  }

  .source-row {
    display: grid;
    grid-template-columns: minmax(4rem, 0.45fr) minmax(0, 1.3fr) minmax(5rem, 0.7fr);
    gap: clamp(0.4rem, 1.5vw, 1.5rem);
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .source-row span:nth-child(2) {
    color: var(--ink);
  }

  .source-note {
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .selection-box {
    position: absolute;
    z-index: 2;
    top: 31%;
    right: 9%;
    bottom: 20%;
    left: 11%;
    pointer-events: none;
  }

  .selection-edge {
    position: absolute;
    display: block;
    background: var(--blue);
    opacity: 1;
  }

  .selection-edge-top,
  .selection-edge-bottom {
    right: 0;
    left: 0;
    height: 2px;
    transform: scaleX(1);
    transform-origin: left center;
  }

  .selection-edge-top {
    top: 0;
  }

  .selection-edge-bottom {
    bottom: 0;
    transform-origin: right center;
  }

  .selection-edge-left,
  .selection-edge-right {
    top: 0;
    bottom: 0;
    width: 2px;
    transform: scaleY(1);
    transform-origin: top center;
  }

  .selection-edge-left {
    left: 0;
  }

  .selection-edge-right {
    right: 0;
    transform-origin: bottom center;
  }

  .clipboard-sheet {
    display: flex;
    min-width: 0;
    min-height: 100%;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-surface);
    background: var(--blue-pale);
  }

  .clipboard-topline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line-strong);
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .clipboard-status {
    color: var(--green);
  }

  .clipboard-body {
    display: flex;
    min-height: 15rem;
    flex-direction: column;
    justify-content: space-between;
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .clipboard-result {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.45rem, 3.2vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 1.08;
    overflow-wrap: anywhere;
  }

  .clipboard-note {
    margin: 2rem 0 0;
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .gesture-caption {
    margin: 0.85rem 0 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .section-intro {
    max-width: 34rem;
  }

  .section-intro h2,
  .details-column h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.075em;
    line-height: 0.98;
  }

  .section-intro p,
  .details-column > p {
    margin: 1rem 0 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .workflow-section {
    padding-block: clamp(4rem, 10vw, 9rem);
  }

  .workflow-line {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(2.5rem, 5vw, 4.5rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    list-style: none;
  }

  .workflow-line li {
    display: flex;
    min-height: 8.5rem;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    padding: 1.25rem clamp(0.75rem, 2.5vw, 2rem);
    color: var(--ink-soft);
  }

  .workflow-line li + li {
    border-left: 1px solid var(--line-strong);
  }

  .workflow-line kbd,
  .workflow-line strong {
    width: fit-content;
    color: var(--ink);
    font-family: var(--sans);
    font-size: clamp(1.15rem, 2.3vw, 1.65rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .workflow-line kbd {
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--line-strong);
    border-bottom-width: 2px;
    border-radius: var(--r-control);
    background: var(--paper-deep);
  }

  .workflow-line span {
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.4;
  }

  .proof-section {
    padding-block: clamp(4rem, 10vw, 9rem);
  }

  .proof-intro {
    margin-left: auto;
  }

  .proof-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 5vw, 5rem);
    margin-top: clamp(3rem, 7vw, 6rem);
  }

  .proof-item {
    min-width: 0;
    padding-top: 1.35rem;
    border-top: 1px solid var(--line-strong);
  }

  .proof-item h3 {
    margin: 1.35rem 0 0;
    color: var(--ink);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .proof-item p {
    max-width: 19rem;
    margin: 0.7rem 0 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .qr-visual {
    display: grid;
    width: clamp(6.5rem, 13vw, 9rem);
    height: clamp(6.5rem, 13vw, 9rem);
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
    padding: 0.55rem;
    border: 1px solid var(--line-strong);
    background: var(--paper);
  }

  .qr-cell-on {
    background: var(--ink);
  }

  .qr-cell-off {
    background: var(--paper);
  }

  .script-visual {
    display: grid;
    min-height: clamp(6.5rem, 13vw, 9rem);
    align-content: center;
    gap: 0.25rem 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    color: var(--blue-ink);
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    letter-spacing: -0.04em;
    line-height: 1.35;
  }

  .script-visual span:nth-child(2) {
    color: var(--ink);
  }

  .script-visual span:nth-child(3) {
    color: var(--ink-soft);
  }

  .script-visual span:nth-child(4) {
    color: var(--blue);
  }

  .code-visual {
    display: flex;
    min-height: clamp(6.5rem, 13vw, 9rem);
    align-items: center;
    flex-wrap: wrap;
    gap: 0.15rem 0.35rem;
    padding: 1rem;
    border: 1px solid var(--line-strong);
    background: var(--paper-deep);
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    letter-spacing: normal;
    line-height: 1.25;
  }

  .code-visual strong {
    color: var(--blue-ink);
    font-weight: 500;
  }

  .details-section {
    padding-block: clamp(4rem, 10vw, 9rem) clamp(5rem, 12vw, 10rem);
    border-top: 1px solid var(--line-strong);
  }

  .details-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3rem, 10vw, 10rem);
  }

  .details-column {
    min-width: 0;
  }

  .plain-list {
    display: grid;
    gap: 0.8rem;
    margin: 2rem 0 0;
    padding: 0 0 0 1.1rem;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.55;
  }

  .one-gesture-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 2rem 1rem;
    border-top: 1px solid var(--line-strong);
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .one-gesture-footer p {
    margin: 0;
  }

  .one-gesture-footer a {
    color: var(--blue-ink);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .one-gesture-footer a:hover {
    color: var(--blue);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .one-gesture-page {
      --gesture-cycle: 6s;
    }

    .selection-edge-top,
    .selection-edge-bottom {
      animation: draw-horizontal var(--gesture-cycle) var(--ease-in-out) infinite;
      will-change: transform;
    }

    .selection-edge-bottom {
      animation-delay: 0.18s;
    }

    .selection-edge-left,
    .selection-edge-right {
      animation: draw-vertical var(--gesture-cycle) var(--ease-in-out) infinite;
      will-change: transform;
    }

    .selection-edge-left {
      animation-delay: 0.36s;
    }

    .selection-edge-right {
      animation-delay: 0.54s;
    }

    .clipboard-sheet {
      animation: show-clipboard var(--gesture-cycle) var(--ease-out) infinite;
      will-change: transform, opacity;
    }
  }

  @keyframes draw-horizontal {
    0%,
    8% {
      transform: scaleX(0);
    }

    25%,
    82% {
      transform: scaleX(1);
    }

    96%,
    100% {
      transform: scaleX(0);
    }
  }

  @keyframes draw-vertical {
    0%,
    23% {
