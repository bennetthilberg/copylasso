---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { compatibilityFacts, features, privacyFacts, site } from "../../data/site";

const description =
  "Blue Line is a quiet CopyLasso landing page direction that traces screen pixels through local OCR to plain clipboard text.";
---

<SiteLayout
  title="Blue Line · CopyLasso"
  description={description}
  optionNumber={4}
  optionName="Blue Line"
  previousHref="/design-options/option-3/"
  nextHref="/design-options/option-5/"
>
  <div class="blue-line-page">
    <header class="site-header page-header">
      <a class="brand" href="/design-options/" aria-label="CopyLasso design directions">
        <span>{site.name}</span>
      </a>
      <nav class="header-nav" aria-label="Page sections">
        <a href="#how-it-works">How it works</a>
        <a href="#privacy">Privacy</a>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="site-width hero-grid">
          <div class="hero-copy">
            <h1 id="hero-title">Copy anything on your screen.</h1>
            <p class="hero-lead">
              CopyLasso follows one clear route: select visible pixels, let Apple Vision read them locally, and get
              plain text back on your clipboard.
            </p>
            <div class="hero-actions">
              <a class="button hero-download" href={site.downloadHref}>
                <span>{site.downloadLabel}</span>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M12 3v10"></path>
                  <path d="m8 9 4 4 4-4"></path>
                  <path d="M4 15v5h16v-5"></path>
                </svg>
              </a>
              <a class="hero-source text-link" href={site.githubUrl} target="_blank" rel="noreferrer">
                View source on GitHub
              </a>
              <p class="hero-requirements">{site.requirements}</p>
            </div>
          </div>

          <div class="hero-statement" aria-hidden="true">
            <span class="statement-line"></span>
            <p>One line from pixels to paste.</p>
          </div>
        </div>

        <div class="site-width journey-wrap">
          <div class="journey-heading">
            <h2 id="journey-title">From the screen to the clipboard.</h2>
            <p>Three spacious stops make the invisible handoff easy to understand.</p>
          </div>

          <div class="journey" aria-labelledby="journey-title">
            <span class="journey-line" aria-hidden="true"></span>
            <ol class="journey-stages">
              <li class="journey-stage">
                <div class="stage-copy">
                  <h3>Select visible text</h3>
                  <p>Draw a region around the words already in front of you.</p>
                </div>
                <div class="sample-window spreadsheet-sample" aria-hidden="true">
                  <div class="sample-toolbar">
                    <span>Quarterly plan</span>
                    <span>Spreadsheet</span>
                  </div>
                  <div class="spreadsheet-head">
                    <span>Item</span>
                    <span>Owner</span>
                    <span>Next step</span>
                  </div>
                  <div class="spreadsheet-row">
                    <span>Launch notes</span>
                    <span>Bennett</span>
                    <span>Review copy</span>
                  </div>
                  <div class="spreadsheet-row">
                    <span>Release date</span>
                    <span>Team</span>
                    <span>Friday</span>
                  </div>
                  <div class="spreadsheet-row selected-row">
                    <span>Screen text</span>
                    <span>Local</span>
                    <span>Copy this line</span>
                  </div>
                  <div class="selection-box"><span>Screen text · Local · Copy this line</span></div>
                </div>
              </li>

              <li class="journey-stage">
                <div class="stage-copy">
                  <h3>Read every script</h3>
                  <p>Local recognition keeps the shape of the source and the meaning of the words.</p>
                </div>
                <div class="sample-window language-sample" aria-hidden="true">
                  <div class="sample-toolbar">
                    <span>Text recognized</span>
                    <span>Mixed language</span>
                  </div>
                  <div class="language-lines">
                    <p><span>English</span> Read what you see.</p>
                    <p><span>日本語</span> 画面の文字を読む</p>
                    <p><span>Español</span> Texto que ya está visible.</p>
                    <p><span>中文</span> 读取屏幕上的文字</p>
                  </div>
                </div>
              </li>

              <li class="journey-stage">
                <div class="stage-copy">
                  <h3>Copy plain text</h3>
                  <p>The result lands in the clipboard, ready for the app you were already using.</p>
                </div>
                <div class="sample-window clipboard-sample" aria-hidden="true">
                  <div class="sample-toolbar">
                    <span>Clipboard</span>
                    <span>Plain text</span>
                  </div>
                  <p class="clipboard-result">Screen text · Local · Copy this line</p>
                  <p class="clipboard-confirmation"><span aria-hidden="true">✓</span>Copied to clipboard</p>
                </div>
              </li>
            </ol>
          </div>
        </div>
      </section>

      <section id="how-it-works" class="section how-section" aria-labelledby="how-title">
        <div class="site-width">
          <div class="section-heading">
            <h2 id="how-title">Press, select, copy.</h2>
            <p>
              The shortcut opens the native selection moment, then CopyLasso gets out of the way as soon as the text
              is ready.
            </p>
          </div>

          <ol class="steps-list">
            <li>
              <span class="step-number" aria-hidden="true">1</span>
              <div>
                <h3>Press <kbd>{site.shortcut}</kbd></h3>
                <p>Start from any app with the configurable global shortcut.</p>
              </div>
            </li>
            <li>
              <span class="step-number" aria-hidden="true">2</span>
              <div>
                <h3>Select the region</h3>
                <p>Drag around a sentence, a spreadsheet cell, a QR code, or a line of code.</p>
              </div>
            </li>
            <li>
              <span class="step-number" aria-hidden="true">3</span>
              <div>
                <h3>Copy the result</h3>
                <p>Apple Vision recognizes the selection on your Mac and places plain text on the clipboard.</p>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <section id="features" class="section proof-section" aria-labelledby="proof-title">
        <div class="site-width">
          <div class="section-heading proof-heading">
            <h2 id="proof-title">The useful range is visible.</h2>
            <p>
              CopyLasso is built for the things that look copyable until you try: a code, a street sign, a message, or
              a page written in more than one language.
            </p>
          </div>

          <div class="proof-grid">
            <figure class="proof-sample">
              <div class="script-art" aria-hidden="true">
                <p><span>English</span> Read what you see.</p>
                <p><span>日本語</span> 画面の文字を読む</p>
                <p><span>Español</span> Texto visible.</p>
                <p><span>中文</span> 屏幕文字</p>
              </div>
              <figcaption>Multiple scripts stay in the same selection.</figcaption>
            </figure>

            <figure class="proof-sample">
              <div class="qr-art-wrap" aria-hidden="true">
                <svg class="qr-art" viewBox="0 0 120 120" focusable="false">
                  <rect class="qr-background" width="120" height="120" rx="4"></rect>
                  <g class="qr-dark">
                    <rect x="9" y="9" width="30" height="30"></rect>
                    <rect class="qr-background-fill" x="15" y="15" width="18" height="18"></rect>
                    <rect x="21" y="21" width="6" height="6"></rect>
                    <rect x="81" y="9" width="30" height="30"></rect>
                    <rect class="qr-background-fill" x="87" y="15" width="18" height="18"></rect>
                    <rect x="93" y="21" width="6" height="6"></rect>
                    <rect x="9" y="81" width="30" height="30"></rect>
                    <rect class="qr-background-fill" x="15" y="87" width="18" height="18"></rect>
                    <rect x="21" y="93" width="6" height="6"></rect>
                    <rect x="48" y="12" width="6" height="6"></rect>
                    <rect x="60" y="12" width="6" height="6"></rect>
                    <rect x="48" y="24" width="12" height="6"></rect>
                    <rect x="42" y="42" width="6" height="6"></rect>
                    <rect x="54" y="42" width="18" height="6"></rect>
                    <rect x="78" y="48" width="6" height="12"></rect>
                    <rect x="90" y="48" width="12" height="6"></rect>
                    <rect x="48" y="54" width="6" height="18"></rect>
                    <rect x="60" y="54" width="6" height="6"></rect>
                    <rect x="72" y="60" width="18" height="6"></rect>
                    <rect x="42" y="72" width="12" height="6"></rect>
                    <rect x="60" y="72" width="6" height="12"></rect>
                    <rect x="72" y="78" width="6" height="18"></rect>
                    <rect x="84" y="72" width="6" height="6"></rect>
                    <rect x="96" y="66" width="12" height="6"></rect>
                    <rect x="48" y="90" width="12" height="6"></rect>
                    <rect x="60" y="102" width="6" height="6"></rect>
                    <rect x="84" y="90" width="18" height="6"></rect>
                    <rect x="96" y="102" width="6" height="6"></rect>
                  </g>
                </svg>
              </div>
              <figcaption>QR and barcode recognition becomes plain text too.</figcaption>
            </figure>

            <figure class="proof-sample">
              <div class="code-art" aria-hidden="true">
                <span>&lt;section&gt;</span>
                <span>&nbsp;&nbsp;visible text</span>
                <span>&nbsp;&nbsp;&lt;/section&gt;</span>
                <span>Copied as text.</span>
              </div>
              <figcaption>Code characters remain readable after the handoff.</figcaption>
            </figure>
          </div>

          <ul class="feature-facts">
            {features.map((feature) => (
              <li>
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="privacy" class="section privacy-section" aria-labelledby="privacy-title">
        <div class="site-width privacy-layout">
          <div class="section-heading">
            <h2 id="privacy-title">The line stops at your Mac.</h2>
            <p>
              The screen image is short-lived input. Recognition happens locally, the result stays with you, and the
              source image is never turned into a record.
            </p>
          </div>

          <ul class="privacy-list">
            {privacyFacts.map((fact) => <li>{fact}</li>)}
          </ul>
        </div>
      </section>

      <section id="compatibility" class="section compatibility-section" aria-labelledby="compatibility-title">
        <div class="site-width compatibility-layout">
          <div class="section-heading">
            <h2 id="compatibility-title">Ready for the Mac you have.</h2>
            <p>CopyLasso stays small, native, and open source from the first capture onward.</p>
          </div>

          <ul class="compatibility-list">
            {compatibilityFacts.map((fact) => <li>{fact}</li>)}
          </ul>
        </div>
      </section>

      <section id="download" class="section download-section" aria-labelledby="download-title">
        <div class="site-width download-layout">
          <div class="download-copy">
            <h2 id="download-title">Keep the next useful sentence.</h2>
            <p>Free, local-first, and ready whenever the words are visible but not selectable.</p>
          </div>
          <div class="download-followup">
            <a class="button button-secondary" href={site.downloadHref}>
              <span>{site.downloadLabel}</span>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M12 3v11"></path>
                <path d="m8.5 10.5 3.5 3.5 3.5-3.5"></path>
                <path d="M4 16.5V19a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-2.5"></path>
              </svg>
            </a>
            <a class="text-link" href={site.githubUrl} target="_blank" rel="noreferrer">Read the source on GitHub</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer page-footer">
      <div class="footer-row">
        <p>Created by Bennett Hilberg.</p>
        <div class="footer-links">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.githubUrl} target="_blank" rel="noreferrer">Source on GitHub</a>
        </div>
      </div>
    </footer>
  </div>
</SiteLayout>

<style>
  .blue-line-page {
    overflow: clip;
  }

  .blue-line-page .page-header {
    position: relative;
    z-index: 2;
  }

  .blue-line-page .brand {
    font-size: 1.1rem;
  }

  .blue-line-page .header-nav a:not(.button) {
    color: var(--ink-soft);
  }

  .blue-line-page .header-nav a:not(.button):hover {
    color: var(--blue);
  }

  .hero {
    padding-block: clamp(5rem, 10vw, 8rem) clamp(4.5rem, 9vw, 7.5rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(12rem, 0.55fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: end;
  }

  .hero-copy {
    max-width: 43rem;
  }

  .hero-copy h1 {
    max-width: 10ch;
    margin: 0;
    font-size: clamp(3.25rem, 8vw, 7.2rem);
    font-weight: 400;
    letter-spacing: -0.075em;
    line-height: 0.91;
  }

  .hero-lead {
    max-width: 38rem;
    margin: 2rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.48;
  }

  .hero-actions {
    display: grid;
    justify-items: start;
    gap: 0.9rem;
    margin-top: 2.2rem;
  }

  .hero-download svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .hero-source {
    font-size: 0.95rem;
  }

  .hero-requirements {
    margin: 0.15rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .hero-statement {
    display: grid;
    gap: 1rem;
    align-content: end;
    justify-items: start;
    padding-bottom: 0.6rem;
    color: var(--blue-ink);
  }

  .statement-line {
    display: block;
    width: min(100%, 14rem);
    height: 2px;
    background: var(--blue);
  }

  .hero-statement p {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    line-height: 1.12;
  }

  .journey-wrap {
    margin-top: clamp(4.5rem, 9vw, 8rem);
  }

  .journey-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(12rem, 0.45fr);
    gap: 2rem;
    align-items: end;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .journey-heading h2,
  .section-heading h2,
  .download-copy h2 {
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 4.2rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.96;
  }

  .journey-heading h2 {
    max-width: 12ch;
  }

  .journey-heading p {
    max-width: 29ch;
    margin: 0;
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .journey {
    position: relative;
    padding-top: 2rem;
  }

  .journey-line {
    position: absolute;
    z-index: 0;
    top: 11.35rem;
    right: 2.5%;
    left: 2.5%;
    height: 2px;
    overflow: hidden;
    background: var(--blue-pale);
  }

  .journey-line::after {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 24%;
    background: var(--blue);
    content: "";
    transform: translateX(-115%);
    animation: route-travel 9s var(--ease-out) infinite;
  }

  .journey-stages {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journey-stage {
    min-width: 0;
  }

  .stage-copy {
    min-height: 7.5rem;
    padding-right: 0.5rem;
  }

  .stage-copy h3 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .stage-copy p {
    max-width: 28ch;
    margin: 0.65rem 0 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .sample-window {
    position: relative;
    min-height: 15rem;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-surface);
    background: var(--blue-white);
  }

  .sample-toolbar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.84rem;
  }

  .sample-toolbar span:last-child {
    color: var(--blue-ink);
  }

  .spreadsheet-sample {
    padding-bottom: 1rem;
  }

  .spreadsheet-head,
  .spreadsheet-row {
    display: grid;
    grid-template-columns: 1.1fr 0.8fr 1.1fr;
    gap: 0.5rem;
    padding-inline: 1rem;
  }

  .spreadsheet-head {
    padding-top: 0.9rem;
    padding-bottom: 0.5rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .spreadsheet-row {
    position: relative;
    padding-top: 0.55rem;
    padding-bottom: 0.55rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.87rem;
  }

  .selected-row {
    color: var(--ink);
  }

  .selection-box {
    position: absolute;
    top: 9.1rem;
    right: 0.6rem;
    left: 0.6rem;
    display: grid;
    min-height: 2.35rem;
    align-items: center;
    padding-inline: 0.65rem;
    border: 2px solid var(--blue);
    background: rgb(72 123 226 / 0.07);
    color: var(--blue-ink);
    font-size: 0.84rem;
    clip-path: inset(0 100% 0 0);
    animation: selection-draw 9s var(--ease-out) infinite;
  }

  .language-sample {
    padding-bottom: 1rem;
  }

  .language-lines {
    display: grid;
    gap: 0.8rem;
    padding: 1.2rem 1rem;
  }

  .language-lines p,
  .script-art p {
    display: grid;
    grid-template-columns: 4.6rem minmax(0, 1fr);
    gap: 0.7rem;
    margin: 0;
    color: var(--ink);
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .language-lines span,
  .script-art span {
    color: var(--blue-ink);
  }

  .clipboard-sample {
    display: grid;
    align-content: start;
    padding-bottom: 1rem;
  }

  .clipboard-result {
    max-width: 24ch;
    margin: 2rem 1rem 1.5rem;
    color: var(--ink);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.2;
  }

  .clipboard-confirmation {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    margin: auto 1rem 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
    color: var(--green);
    font-size: 0.92rem;
    opacity: 0;
    animation: copy-confirmation 9s var(--ease-out) infinite;
  }

  .clipboard-confirmation span {
    font-size: 1.1rem;
  }

  .section {
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }

  .how-section {
    border-top: 1px solid var(--line-strong);
    background: var(--paper-deep);
  }

  .section-heading {
    max-width: 47rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .section-heading h2 {
    max-width: 14ch;
  }

  .section-heading p {
    max-width: 58ch;
    margin: 1rem 0 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
  }

  .steps-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    list-style: none;
    background: var(--line-strong);
  }

  .steps-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    min-width: 0;
    padding: 1.5rem 1.25rem 1.75rem;
    background: var(--paper-deep);
  }

  .step-number {
    color: var(--blue);
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .steps-list h3,
  .feature-facts h3 {
    margin: 0;
    color: var(--ink);
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .steps-list p,
  .feature-facts p {
    margin: 0.55rem 0 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  kbd {
    display: inline-block;
    padding: 0.12rem 0.35rem;
    border: 1px solid var(--line-strong);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: var(--blue-white);
    color: var(--blue-ink);
    font-size: 0.9em;
    font-weight: 500;
    line-height: 1.1;
  }

  .proof-section {
    background: var(--paper);
  }

  .proof-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(14rem, 0.65fr);
    gap: 2rem;
    max-width: none;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .proof-heading p {
    margin: 0;
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    background: var(--line-strong);
  }

  .proof-sample {
    min-width: 0;
    margin: 0;
    padding: 1.25rem;
    background: var(--paper);
  }

  .script-art,
  .qr-art-wrap,
  .code-art {
    min-height: 12rem;
  }

  .script-art {
    display: grid;
    align-content: center;
    gap: 0.85rem;
  }

  .script-art p {
    grid-template-columns: 4.5rem minmax(0, 1fr);
    font-size: 0.94rem;
  }

  .qr-art-wrap {
    display: grid;
    place-items: center;
  }

  .qr-art {
    display: block;
    width: min(100%, 10.5rem);
    height: auto;
    color: var(--ink);
  }

  .qr-background {
