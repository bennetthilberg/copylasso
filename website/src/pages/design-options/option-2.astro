---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { compatibilityFacts, privacyFacts, site } from "../../data/site";

const description =
  "A proof-strip CopyLasso landing page direction showing local screen OCR across QR codes, languages, and code.";
const compatibilityLabels = ["System", "Architecture", "Permission", "License"];
const emailHref = "mailto:" + site.email;
const qrPattern = [
  "1111100011111",
  "1000100110001",
  "1010101110101",
  "1000100110001",
  "1111101011111",
  "0010101101000",
  "1110010110110",
  "0101110010101",
  "1111100110111",
  "1000100101001",
  "1010101111101",
  "1000100100001",
  "1111101110111",
];
const qrCells = qrPattern.flatMap((row) => [...row]);
---

<SiteLayout
  title="Proof Strip · CopyLasso"
  description={description}
  optionNumber={2}
  optionName="Proof Strip"
  previousHref="/design-options/option-1/"
  nextHref="/design-options/option-3/"
>
  <header class="site-header proof-header">
    <a class="brand" href="/design-options/" aria-label="CopyLasso design directions">
      <span class="brand-mark" aria-hidden="true"></span>
      <span>{site.name}</span>
    </a>
    <nav class="header-nav" aria-label="Page navigation">
      <a href="#how-it-works">How it works</a>
      <a href="#privacy">Privacy</a>
    </nav>
  </header>

  <main id="main-content" class="proof-page">
    <section class="proof-hero" aria-labelledby="hero-title">
      <div class="site-width hero-grid">
        <div class="hero-copy">
          <h1 id="hero-title">Copy anything on your screen.</h1>
          <p class="hero-intro">
            Select a region, let your Mac read the pixels locally, and get clean text on the clipboard. CopyLasso is
            quiet enough to disappear after the useful part is copied.
          </p>

          <div class="hero-actions">
            <a class="button hero-download" href={site.downloadHref}>
              {site.downloadLabel}
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 13.25v2.5h12v-2.5"></path>
                <path d="M10 3.25v8.25"></path>
                <path d="m6.75 8.75 3.25 3.25 3.25-3.25"></path>
              </svg>
            </a>
            <a class="hero-source" href={site.githubUrl} rel="noreferrer">View source on GitHub</a>
          </div>
          <p class="hero-requirements">{site.requirements}</p>
        </div>

        <figure class="capture-figure" aria-labelledby="capture-caption">
          <div class="capture-window" aria-hidden="true">
            <div class="window-titlebar">
              <span class="window-title">Visible screen</span>
              <span class="window-context">CopyLasso selection</span>
            </div>

            <div class="capture-body">
              <div class="screen-source">
                <div class="source-heading">
                  <p class="source-title">Weekly planning</p>
                  <span class="source-date">This week</span>
                </div>
                <div class="sheet-table">
                  <div class="sheet-row sheet-row-header">
                    <span>Task</span>
                    <span>Status</span>
                    <span>Next step</span>
                  </div>
                  <div class="sheet-row">
                    <span>Copy notes</span>
                    <span>Ready</span>
                    <span>Today</span>
                  </div>
                  <div class="sheet-row">
                    <span>Review draft</span>
                    <span>Waiting</span>
                    <span>Tomorrow</span>
                  </div>
                  <div class="sheet-row">
                    <span>Share findings</span>
                    <span>Open</span>
                    <span>Friday</span>
                  </div>
                </div>
                <p class="source-footer">Shared with your team</p>
                <span class="selection-box">
                  <span class="selection-tag">selected text</span>
                </span>
              </div>

              <div class="capture-result">
                <p class="result-label">Plain-text result</p>
                <p class="result-text">Copy notes · ready for today</p>
                <p class="result-status"><span class="status-check" aria-hidden="true">✓</span>Copied to clipboard</p>
              </div>
            </div>
          </div>
          <figcaption id="capture-caption" class="capture-caption">
            <span class="caption-lead">Drag over the words.</span>
            <span>The source stays visible while the selected pixels become a plain-text result.</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section id="proof" class="section proof-section" aria-labelledby="proof-title">
      <div class="site-width">
        <div class="proof-intro">
          <h2 id="proof-title">Proof you can see.</h2>
          <p>
            The selection is useful because it meets the screen as it is: a code on a poster, words in another script,
            or a few lines from a project window.
          </p>
        </div>

        <div class="proof-strip">
          <article class="proof-moment">
            <h3>Codes become text.</h3>
            <p>Point at a supported QR or barcode and keep the payload as ordinary clipboard text.</p>
            <div class="proof-visual qr-visual" role="img" aria-label="A QR-like code with a plain-text result">
              <div class="qr-grid" aria-hidden="true">
                {qrCells.map((cell) => (
                  <span class:list={["qr-cell", cell === "1" ? "is-filled" : ""]}></span>
                ))}
              </div>
              <p class="qr-result">Meeting room 4B · 10:30</p>
            </div>
            <p class="proof-caption">Supported code formats arrive as inert text, ready to paste.</p>
          </article>

          <article class="proof-moment">
            <h3>Languages stay readable.</h3>
            <p>Apple Vision can recognize the scripts already present in the region you select.</p>
            <div class="proof-visual script-visual">
              <p class="script-line" lang="en">Save the original words.</p>
              <p class="script-line" lang="zh">保留原来的文字。</p>
              <p class="script-line" lang="ar" dir="rtl">احتفظ بالكلمات الأصلية.</p>
            </div>
            <p class="proof-caption">English, Mandarin, and Arabic can share one calm workflow.</p>
          </article>

          <article class="proof-moment">
            <h3>Code stays code.</h3>
            <p>Readable characters come through without turning a screen capture into an image.</p>
            <div class="proof-visual code-visual" role="img" aria-label="A readable code sample with a copy call">
              <div class="code-proof" aria-hidden="true">
                <p class="code-line"><span class="code-keyword">if</span> selection.isReady &#123;</p>
                <p class="code-line code-indent"><span class="code-call">copy</span>(selection.text)</p>
                <p class="code-line">&#125;</p>
              </div>
              <p class="code-result">Plain text on the clipboard</p>
            </div>
            <p class="proof-caption">Select a readable snippet and paste it where the work continues.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="how-it-works" class="section workflow-section" aria-labelledby="workflow-title">
      <div class="site-width workflow-grid">
        <div class="workflow-intro">
          <h2 id="workflow-title">Three simple moves.</h2>
          <p>
            CopyLasso keeps the interaction short so you can return to the app that was already in front of you.
          </p>
        </div>

        <ol class="workflow-list">
          <li class="workflow-step">
            <span class="step-number" aria-hidden="true">01</span>
            <div class="step-detail">
              <h3>Press <kbd class="keycap">{site.shortcut}</kbd></h3>
              <p>Use the configurable shortcut to bring up the system selection crosshair.</p>
            </div>
          </li>
          <li class="workflow-step">
            <span class="step-number" aria-hidden="true">02</span>
            <div class="step-detail">
              <h3>Select a region.</h3>
              <p>Drag over the words, code, or image detail that is already visible on your screen.</p>
            </div>
          </li>
          <li class="workflow-step">
            <span class="step-number" aria-hidden="true">03</span>
            <div class="step-detail">
              <h3>Copy clean text.</h3>
              <p>Local Apple Vision recognition puts the result on your clipboard, ready for the next app.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section id="privacy" class="section trust-section" aria-labelledby="privacy-title">
      <div class="site-width trust-grid">
        <section class="trust-block" aria-labelledby="privacy-title">
          <h2 id="privacy-title">Private by default.</h2>
          <p>
            A screen selection is short-lived input. CopyLasso keeps capture and recognition on the Mac and does not
            turn the source image into a record.
          </p>
          <ul class="privacy-list">
            {privacyFacts.map((fact) => (
              <li>
                <span class="privacy-mark" aria-hidden="true">✓</span>
                <span>{fact}</span>
              </li>
            ))}
          </ul>
        </section>

        <section id="compatibility" class="trust-block" aria-labelledby="compatibility-title">
          <h2 id="compatibility-title">Works with the Mac you use.</h2>
          <p>One native utility, one capture permission, and no account setup before the first useful copy.</p>
          <dl class="compatibility-list">
            {compatibilityFacts.map((fact, index) => (
              <div>
                <dt>{compatibilityLabels[index]}</dt>
                <dd>{fact}</dd>
              </div>
            ))}
          </dl>
        </section>
      </div>
    </section>

    <section id="download" class="section download-section" aria-labelledby="download-title">
      <div class="site-width download-layout">
        <div>
          <h2 id="download-title">Keep the useful part.</h2>
          <p>
            CopyLasso is free and open source, built for the screen already in front of you. Select once, copy the
            words, and get back to the work that called for them.
          </p>
        </div>
        <p class="download-callout">
          A small local utility for the moments when the screen has the words but the clipboard does not.
        </p>
      </div>
    </section>
  </main>

  <footer class="footer proof-footer">
    <div class="footer-row">
      <p>Created by Bennett Hilberg</p>
      <div class="footer-links">
        <a href={emailHref}>{site.email}</a>
        <a href={site.githubUrl} rel="noreferrer">View source on GitHub</a>
      </div>
    </div>
  </footer>
</SiteLayout>

<style>
  .proof-page {
    --proof-blue: var(--blue);
    --proof-blue-deep: var(--blue-deep);
    --proof-blue-pale: var(--blue-pale);
    --proof-surface: var(--paper-deep);
    --proof-line: var(--line);
    --proof-line-strong: var(--line-strong);
    overflow-x: clip;
  }

  .proof-page h1,
  .proof-page h2,
  .proof-page h3 {
    font-family: var(--sans);
    font-weight: 400;
    text-wrap: balance;
  }

  .proof-header {
    position: relative;
    z-index: 1;
  }

  .proof-header .brand-mark {
    width: 1.45rem;
    height: 0.85rem;
    border: 2px solid currentColor;
    border-left-color: transparent;
    border-radius: 50%;
    color: var(--blue);
    transform: rotate(-28deg);
  }

  .proof-header .header-nav {
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .proof-header .header-nav a {
    color: var(--ink-soft);
  }

  .proof-hero {
    padding-block: clamp(4.5rem, 10vw, 8.5rem) clamp(4rem, 9vw, 7.5rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.84fr) minmax(0, 1.16fr);
    gap: clamp(2.75rem, 7vw, 7rem);
    align-items: center;
  }

  .hero-copy {
    min-width: 0;
    max-width: 40rem;
  }

  .proof-hero h1 {
    max-width: 9ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(3.4rem, 7.8vw, 7.5rem);
    letter-spacing: -0.08em;
    line-height: 0.9;
  }

  .hero-intro {
    max-width: 38rem;
    margin: 2rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.08rem, 1.7vw, 1.28rem);
    line-height: 1.55;
  }

  .hero-actions {
    display: grid;
    justify-items: start;
    gap: 0.8rem;
    margin-top: 2.2rem;
  }

  .hero-download {
    min-height: 3.45rem;
    padding-inline: 1.25rem;
  }

  .hero-download svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .hero-source {
    display: inline-flex;
    min-height: 2.6rem;
    align-items: center;
    color: var(--blue-ink);
    font-size: 1rem;
    font-weight: 600;
  }

  .hero-requirements {
    margin: 1.3rem 0 0;
    color: var(--muted);
    font-size: 1rem;
  }

  .capture-figure {
    min-width: 0;
    margin: 0;
  }

  .capture-window {
    overflow: hidden;
    border: 1px solid var(--proof-line-strong);
    border-radius: var(--r-surface);
    background: var(--paper);
  }

  .window-titlebar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1.15rem;
    border-bottom: 1px solid var(--proof-line);
    color: var(--ink-soft);
    font-size: 0.94rem;
  }

  .window-title {
    color: var(--ink);
    font-weight: 500;
  }

  .window-context {
    color: var(--muted);
  }

  .capture-body {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(12rem, 0.7fr);
  }

  .screen-source {
    position: relative;
    min-width: 0;
    min-height: 25rem;
    padding: 1.35rem;
    background: var(--blue-white);
  }

  .source-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .source-title,
  .source-date,
  .source-footer {
    margin: 0;
  }

  .source-title {
    color: var(--ink);
    font-size: 1.08rem;
    font-weight: 500;
  }

  .source-date,
  .source-footer {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .sheet-table {
    display: grid;
    gap: 0;
    margin-top: 1.25rem;
  }

  .sheet-row {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(4.5rem, 0.8fr) minmax(4.5rem, 0.7fr);
    gap: 0.65rem;
    padding: 0.7rem 0.65rem;
    border-bottom: 1px solid var(--proof-line);
    color: var(--ink-soft);
    font-size: 0.93rem;
  }

  .sheet-row span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .sheet-row-header {
    padding-top: 0;
    color: var(--muted);
    font-size: 0.86rem;
  }

  .source-footer {
    margin-top: 1.1rem;
  }

  .selection-box {
    position: absolute;
    z-index: 1;
    inset: 37% 7% 21% 7%;
    border: 2px solid var(--proof-blue);
    background: rgb(0 105 210 / 0.06);
    transform-origin: top left;
    animation: proof-selection 6s var(--ease-out) infinite;
  }

  .selection-tag {
    position: absolute;
    top: -1.85rem;
    left: -2px;
    padding: 0.34rem 0.52rem;
    border-radius: 4px;
    background: var(--proof-blue);
    color: var(--blue-white);
    font-size: 0.82rem;
    line-height: 1.1;
  }

  .capture-result {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: 1.35rem;
    border-left: 1px solid var(--proof-line);
    background: var(--proof-surface);
    animation: proof-result 6s var(--ease-out) infinite;
  }

  .result-label,
  .result-text,
  .result-status {
    margin: 0;
  }

  .result-label {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .result-text {
    margin-top: 0.7rem;
    color: var(--ink);
    font-size: clamp(1.2rem, 2.3vw, 1.55rem);
    line-height: 1.22;
    overflow-wrap: anywhere;
  }

  .result-status {
    display: flex;
    gap: 0.45rem;
    margin-top: 1.4rem;
    color: var(--green);
    font-size: 0.96rem;
  }

  .status-check {
    font-size: 1.1rem;
    line-height: 1;
  }

  .capture-caption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.6rem;
    margin: 1.1rem 0 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.5;
  }

  .caption-lead {
    color: var(--ink);
    font-weight: 500;
  }

  .proof-section {
    border-top: 1px solid var(--proof-line-strong);
  }

  .proof-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .proof-intro h2,
  .workflow-intro h2,
  .trust-block h2,
  .download-layout h2 {
    max-width: 11ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    letter-spacing: -0.07em;
    line-height: 0.95;
  }

  .proof-intro p,
  .workflow-intro p,
  .trust-block > p,
  .download-layout p {
    max-width: 40rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.1rem;
    line-height: 1.55;
  }

  .proof-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 2px solid var(--ink);
  }

  .proof-moment {
    min-width: 0;
    padding: 1.4rem 1.25rem 0 0;
  }

  .proof-moment + .proof-moment {
    padding-left: 1.5rem;
    border-left: 1px solid var(--proof-line);
  }

  .proof-moment h3 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.35rem, 2.3vw, 1.8rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .proof-moment > p:not(.proof-caption) {
    min-height: 4.8rem;
    margin: 0.7rem 0 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.5;
  }

  .proof-visual {
    display: flex;
    min-height: 23rem;
    flex-direction: column;
    justify-content: space-between;
    margin-top: 1.4rem;
    padding: 1.35rem;
    border: 1px solid var(--proof-line);
    background: var(--proof-surface);
  }

  .qr-visual {
    align-items: center;
  }

  .qr-grid {
    display: grid;
    grid-template-columns: repeat(13, minmax(0, 1fr));
    gap: 0.22rem;
    width: min(100%, 15rem);
    aspect-ratio: 1;
    padding: 0.65rem;
    border: 1px solid var(--proof-line-strong);
    background: var(--blue-white);
  }

  .qr-cell {
    min-width: 0;
    aspect-ratio: 1;
    background: transparent;
  }

  .qr-cell.is-filled {
    background: var(--ink);
  }

  .qr-result,
  .code-result {
    width: 100%;
    margin: 1.2rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--proof-line-strong);
    color: var(--blue-ink);
    font-size: 1.12rem;
    line-height: 1.35;
  }

  .script-visual {
    justify-content: center;
    gap: 1.35rem;
  }

  .script-line {
    margin: 0;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--proof-line);
    color: var(--ink);
    font-size: clamp(1.45rem, 3vw, 2.15rem);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .script-line:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .code-visual {
    justify-content: center;
  }

  .code-proof {
    display: grid;
    gap: 0.45rem;
    color: var(--ink);
    font-family: var(--sans);
    font-size: clamp(1.12rem, 2.2vw, 1.55rem);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .code-line {
    margin: 0;
  }

  .code-indent {
    padding-left: 1.25rem;
  }

  .code-keyword,
  .code-call {
    color: var(--blue-ink);
    font-weight: 500;
  }

  .proof-caption {
    margin: 1.15rem 0 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.5;
  }

  .workflow-section {
    border-top: 1px solid var(--proof-line-strong);
    background: var(--proof-surface);
  }

  .workflow-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(2.5rem, 8vw, 9rem);
    align-items: start;
  }

  .workflow-intro {
    position: sticky;
    top: 2rem;
  }

  .workflow-intro p {
    margin-top: 1.4rem;
  }

  .workflow-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .workflow-step {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.45rem 0;
    border-top: 1px solid var(--proof-line-strong);
  }

  .workflow-step:last-child {
    border-bottom: 1px solid var(--proof-line-strong);
  }

  .step-number {
    color: var(--proof-blue);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .step-detail h3 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    letter-spacing: -0.05em;
    line-height: 1.1;
  }

  .step-detail p {
    max-width: 36rem;
    margin: 0.65rem 0 0;
    color: var(--ink-soft);
    font-size: 1.03rem;
    line-height: 1.55;
  }

  .keycap {
    display: inline-flex;
    min-width: 2.5rem;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--proof-line-strong);
    border-radius: var(--r-control);
    background: var(--blue-white);
    color: var(--blue-ink);
    font-family: var(--sans);
    font-size: 0.78em;
    font-weight: 400;
    line-height: 1;
  }

  .trust-section {
    border-top: 1px solid var(--proof-line-strong);
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 7vw, 7rem);
  }

  .trust-block {
    min-width: 0;
  }

  .trust-block + .trust-block {
    padding-left: clamp(1.5rem, 4vw, 4rem);
    border-left: 1px solid var(--proof-line-strong);
  }

  .trust-block > p {
    margin-top: 1.4rem;
  }

