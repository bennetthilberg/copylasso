---
import SiteLayout from "../layouts/SiteLayout.astro";
import DownloadIcon from "../components/DownloadIcon.astro";
import { compatibilityFacts, privacyFacts, site } from "../data/site";

const description =
  "Copy anything on your Mac screen. CopyLasso turns selected pixels into clipboard text with private, on-device OCR.";

const qrPattern = [
  "111111101010111", "100000101101001", "101110101011101", "101110100101101", "101110101110101",
  "100000100011001", "111111101010101", "000000001101000", "110011111011101", "001101001100010",
  "111011101011111", "100010011010001", "101110111110101", "100010001010001", "111111101111111",
];
const qrCells = qrPattern.flatMap((row) => row.split(""));
const qrPath = qrCells
  .map((cell, index) => (cell === "1" ? `M${index % 15} ${Math.floor(index / 15)}h1v1h-1z` : ""))
  .join("");
---

<SiteLayout title="CopyLasso · Copy anything on your screen" description={description}>
  <div class="landing-page">
    <header class="site-header landing-header">
      <a class="landing-brand" href="#main-content" aria-label="CopyLasso home">CopyLasso</a>
      <nav class="landing-nav" aria-label="Page sections">
        <a href="#how-it-works">How it works</a>
        <a href="#features">Features</a>
        <a href="#privacy">Privacy</a>
        <a href={site.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">Copy anything on your screen.</h1>
          <p>
            Draw around text you can see anywhere on your Mac. CopyLasso reads the pixels locally and puts clean
            text on your clipboard.
          </p>
        </div>

        <div class="hero-actions" aria-label="Download CopyLasso or view its source">
          <a class="download-button" href={site.downloadHref}>
            <DownloadIcon />
            <span>{site.downloadLabel}</span>
          </a>
          <a class="source-button" href={site.githubUrl} target="_blank" rel="noreferrer">
            View source on GitHub
          </a>
        </div>
        <p class="hero-requirements">{site.requirements}</p>

        <p class="sr-only">
          A demonstration shows a street sign reading 7th Street above a storefront reading Starbucks Coffee. A
          selection is drawn around both, producing the clipboard text 7th Street Starbucks.
        </p>

        <figure class="capture-demo" aria-hidden="true">
          <div class="demo-pane demo-source">
            <div class="demo-heading">
              <strong>What you see</strong>
              <span>A photo on your screen</span>
            </div>

            <div class="street-scene">
              <div class="sky-line"></div>
              <div class="building building-back"></div>
              <div class="building building-side"></div>
              <div class="street-post"></div>
              <div class="street-sign">7th Street</div>
              <div class="storefront">
                <div class="storefront-glass"></div>
                <div class="storefront-name">STARBUCKS COFFEE</div>
                <div class="awning">
                  <span></span><span></span><span></span><span></span><span></span>
                </div>
                <div class="storefront-door"></div>
              </div>
              <div class="sidewalk"></div>

              <div class="selection-frame">
                <span class="selection-edge selection-top"></span>
                <span class="selection-edge selection-right"></span>
                <span class="selection-edge selection-bottom"></span>
                <span class="selection-edge selection-left"></span>
                <span class="selection-crosshair"></span>
              </div>
            </div>
          </div>

          <div class="demo-pane demo-result">
            <div class="demo-heading">
              <strong>What you get</strong>
              <span>Clipboard</span>
            </div>
            <div class="result-body">
              <p class="result-copy">7th Street Starbucks</p>
              <div class="result-status">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m5 12.5 4 4L19 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span>Copied to clipboard</span>
              </div>
            </div>
          </div>
        </figure>
      </section>

      <section id="how-it-works" class="section-shell workflow" aria-labelledby="workflow-title">
        <div class="section-intro">
          <h2 id="workflow-title">Three moves.</h2>
          <p>No app switching, file importing, or retyping. The whole workflow lives in one shortcut.</p>
        </div>

        <ol class="workflow-list">
          <li>
            <span class="step-number">1</span>
            <div>
              <h3>Press <kbd aria-label="Shift Command 2">{site.shortcut}</kbd></h3>
              <p>Start a capture from whatever app is already in front of you.</p>
            </div>
          </li>
          <li>
            <span class="step-number">2</span>
            <div>
              <h3>Draw</h3>
              <p>Drag a box around the words, code, or sign you want.</p>
            </div>
          </li>
          <li>
            <span class="step-number">3</span>
            <div>
              <h3>Paste</h3>
              <p>The recognized result is already waiting on your clipboard.</p>
            </div>
          </li>
        </ol>
      </section>

      <section id="features" class="features" aria-labelledby="features-title">
        <div class="section-shell feature-heading">
          <h2 id="features-title">It reads more than paragraphs.</h2>
          <p>Copy the things that usually make you stop and retype.</p>
        </div>

        <div class="section-shell feature-specimens">
          <article class="feature-specimen feature-codes">
            <svg class="qr-code" viewBox="0 0 15 15" role="img" aria-label="Example QR code">
              <rect width="15" height="15" fill="white"></rect>
              <path d={qrPath} fill="currentColor"></path>
            </svg>
            <div class="feature-copy">
              <h3>QR and barcodes</h3>
              <p>Recognize supported codes as inert plain text, ready to paste.</p>
            </div>
          </article>

          <article class="feature-specimen feature-languages">
            <div class="language-stack" aria-label="Text shown in several languages">
              <span>Hello</span>
              <span lang="zh-Hans">你好</span>
              <span lang="ja">こんにちは</span>
              <span lang="ar" dir="rtl">مرحبا</span>
            </div>
            <div class="feature-copy">
              <h3>Your languages</h3>
              <p>Choose and prioritize the OCR languages available on your Mac.</p>
            </div>
          </article>

          <article class="feature-specimen feature-code">
            <div class="code-sample" aria-label="A visible code example">
              <span>const result =</span>
              <strong>"copied"</strong>
              <span>;</span>
            </div>
            <div class="feature-copy">
              <h3>Text from any app</h3>
              <p>Photos, paused videos, remote desktops, menus, and code are all just screen pixels.</p>
            </div>
          </article>
        </div>
      </section>

      <section id="privacy" class="section-shell trust" aria-labelledby="privacy-title">
        <div class="trust-statement">
          <h2 id="privacy-title">Your screen stays on your Mac.</h2>
          <p>CopyLasso uses Apple Vision on device. There is no account, cloud OCR, analytics, or telemetry.</p>
        </div>

        <div class="trust-details">
          <div>
            <h3>Private by default</h3>
            <ul>
              {privacyFacts.map((fact) => <li>{fact}</li>)}
            </ul>
          </div>
          <div id="compatibility">
            <h3>Made for recent Macs</h3>
            <ul>
              {compatibilityFacts.map((fact) => <li>{fact}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section id="download" class="closing" aria-labelledby="closing-title">
        <div class="section-shell closing-inner">
          <h2 id="closing-title">The words are already there.</h2>
          <p>Copy them.</p>
          <div class="closing-actions">
            <a class="download-button" href={site.downloadHref}>
              <DownloadIcon />
              <span>{site.downloadLabel}</span>
            </a>
            <a href={site.githubUrl} target="_blank" rel="noreferrer">View source on GitHub</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="section-shell landing-footer">
      <p>Created by <a href={`mailto:${site.email}`}>Bennett Hilberg</a>.</p>
      <div>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
        <span>MIT licensed</span>
      </div>
    </footer>
  </div>
</SiteLayout>

<style>
  .landing-page {
    --page-width: 74rem;
    --section-space: clamp(5rem, 10vw, 9rem);
    min-width: 0;
    overflow-x: clip;
  }

  .section-shell,
  .landing-header,
  .hero {
    width: min(calc(100% - 2rem), var(--page-width));
    margin-inline: auto;
  }

  .landing-header { padding-block: 1.4rem; }

  .landing-brand {
    color: var(--ink);
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  .landing-nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
    color: var(--ink-soft);
  }

  .landing-nav a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
  }

  .hero {
    padding: clamp(4.5rem, 9vw, 8rem) 0 var(--section-space);
    text-align: center;
  }

  .hero-copy {
    width: min(100%, 66rem);
    margin-inline: auto;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(3.2rem, 8vw, 7.5rem);
    font-weight: 550;
    letter-spacing: -0.07em;
    line-height: 0.92;
    text-wrap: balance;
  }

  .hero-copy > p {
    max-width: 43rem;
    margin: 1.75rem auto 0;
    color: var(--ink-soft);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.55;
    text-wrap: balance;
  }

  .hero-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    width: min(100%, 37rem);
    margin: 2.25rem auto 0;
  }

  .download-button,
  .source-button {
    min-height: 3.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    padding: 0.9rem 1.2rem;
    border-radius: 8px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
  }

  .download-button {
    border: 1px solid var(--blue);
    background: var(--blue);
    color: var(--blue-white);
  }

  .download-button :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
  }

  .source-button {
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink);
  }

  .download-button:hover {
    border-color: var(--blue-deep);
    background: var(--blue-deep);
    color: var(--blue-white);
  }

  .source-button:hover {
    border-color: var(--blue);
    color: var(--blue-ink);
  }

  .hero-requirements {
    margin: 0.9rem 0 0;
    color: var(--muted);
    font-size: 1rem;
  }

  .capture-demo {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(17rem, 0.75fr);
    margin: clamp(4rem, 8vw, 7rem) 0 0;
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    overflow: hidden;
    background: white;
    text-align: left;
  }

  .demo-pane {
    min-width: 0;
    padding: clamp(1rem, 2.5vw, 1.75rem);
  }

  .demo-source {
    border-right: 1px solid var(--line-strong);
    background: var(--paper-deep);
  }

  .demo-result {
    display: flex;
    flex-direction: column;
    background: var(--paper);
  }

  .demo-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .demo-heading strong {
    font-size: 1.1rem;
    font-weight: 600;
  }

  .demo-heading span {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .street-scene {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px;
    background: #bcd8ed;
  }

  .sky-line { position: absolute; inset: 52% 0 0; background: #c7d0d7; }

  .building {
    position: absolute;
    background: #dce3e8;
    border: 1px solid rgb(22 45 69 / 0.14);
  }

  .building-back { inset: 11% 57% 43% 4%; }
  .building-side { inset: 22% 2% 43% 75%; background: #c5d1d9; }

  .building-back::before,
  .building-back::after,
  .building-side::before,
  .building-side::after {
    position: absolute;
    width: 15%;
    height: 22%;
    background: #92afc2;
    content: "";
  }

  .building-back::before { inset: 16% auto auto 15%; }
  .building-back::after { inset: 16% 15% auto auto; }
  .building-side::before { inset: 18% auto auto 14%; }
  .building-side::after { inset: 18% 14% auto auto; }

  .street-post {
    position: absolute;
    z-index: 3;
    top: 12%;
    bottom: 22%;
    left: 18%;
    width: 0.5%;
    min-width: 3px;
    background: #273f54;
  }

  .street-sign {
    position: absolute;
    z-index: 4;
    top: 14%;
    left: 9%;
    min-width: 25%;
    padding: 1.4% 2.2%;
    border: 2px solid #e5f1fb;
    border-radius: 5px;
    background: #244b70;
    color: white;
    font-size: clamp(0.72rem, 1.85vw, 1.25rem);
    font-weight: 600;
    line-height: 1;
    text-align: center;
  }

  .storefront {
    position: absolute;
    z-index: 2;
    inset: 36% 7% 12% 29%;
    border: 1px solid rgb(22 45 69 / 0.18);
    background: #e7ecef;
  }

  .storefront-name {
    position: absolute;
    z-index: 3;
    inset: 8% 7% auto;
    color: #223b50;
    font-size: clamp(0.67rem, 1.8vw, 1.28rem);
    font-weight: 600;
    letter-spacing: 0.025em;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
  }

  .storefront-glass { position: absolute; inset: 36% 4% 5%; background: #7899ae; }

  .storefront-glass::after {
    position: absolute;
    inset: 0 48% 0 auto;
    width: 1px;
    background: rgb(234 245 252 / 0.7);
    content: "";
  }

  .awning {
    position: absolute;
    z-index: 2;
    top: 28%;
    right: 0;
    left: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    height: 12%;
    overflow: hidden;
    border-block: 1px solid rgb(22 45 69 / 0.2);
  }

  .awning span:nth-child(odd) { background: #f5f7f8; }
  .awning span:nth-child(even) { background: #4e7391; }

  .storefront-door {
    position: absolute;
    z-index: 3;
    right: 10%;
    bottom: 5%;
    width: 17%;
    height: 50%;
    border: 1px solid #d9e8f1;
    background: #49697f;
  }

  .sidewalk {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 14%;
    border-top: 2px solid #8b9aa5;
    background: #aeb8bf;
  }

  .selection-frame { position: absolute; z-index: 8; inset: 9% 5% 29% 6%; }
  .selection-edge { position: absolute; background: #0877df; opacity: 0; }

  .selection-top,
  .selection-bottom { right: 0; left: 0; height: 3px; transform: scaleX(0); }

  .selection-right,
  .selection-left { top: 0; bottom: 0; width: 3px; transform: scaleY(0); }

  .selection-top { top: 0; transform-origin: left center; }
  .selection-right { right: 0; transform-origin: center top; }
  .selection-bottom { bottom: 0; transform-origin: right center; }
  .selection-left { left: 0; transform-origin: center bottom; }

  .selection-crosshair {
    position: absolute;
    right: -0.45rem;
    bottom: -0.45rem;
    width: 1rem;
    height: 1rem;
    opacity: 0;
  }

  .selection-crosshair::before,
  .selection-crosshair::after { position: absolute; background: #0877df; content: ""; }
  .selection-crosshair::before { inset: 0 7px; }
  .selection-crosshair::after { inset: 7px 0; }

  .result-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    min-height: 14rem;
    padding: clamp(1.25rem, 3vw, 2rem) 0 0;
  }

  .result-copy {
    max-width: 11ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.15rem, 4.3vw, 4.25rem);
    font-weight: 550;
    letter-spacing: -0.055em;
    line-height: 0.98;
    opacity: 0;
    transform: translateX(-0.75rem);
  }

  .result-status {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--blue-ink);
    font-size: 1rem;
    font-weight: 600;
    opacity: 0;
  }

  .result-status svg { width: 1.3rem; height: 1.3rem; }

  @media (prefers-reduced-motion: no-preference) {
    .selection-top { animation: draw-horizontal 7s cubic-bezier(0.23, 1, 0.32, 1) infinite; }
    .selection-right { animation: draw-vertical 7s cubic-bezier(0.23, 1, 0.32, 1) 0.32s infinite; }
    .selection-bottom { animation: draw-horizontal 7s cubic-bezier(0.23, 1, 0.32, 1) 0.64s infinite; }
    .selection-left { animation: draw-vertical 7s cubic-bezier(0.23, 1, 0.32, 1) 0.96s infinite; }
    .selection-crosshair { animation: show-crosshair 7s linear infinite; }
    .result-copy { animation: show-result 7s cubic-bezier(0.23, 1, 0.32, 1) infinite; }
    .result-status { animation: show-status 7s linear infinite; }
  }

  @keyframes draw-horizontal {
    0%, 8% { opacity: 0; transform: scaleX(0); }
    10% { opacity: 1; transform: scaleX(0); }
    18%, 83% { opacity: 1; transform: scaleX(1); }
    92%, 100% { opacity: 0; transform: scaleX(1); }
  }

  @keyframes draw-vertical {
    0%, 8% { opacity: 0; transform: scaleY(0); }
    10% { opacity: 1; transform: scaleY(0); }
    18%, 83% { opacity: 1; transform: scaleY(1); }
    92%, 100% { opacity: 0; transform: scaleY(1); }
  }

  @keyframes show-crosshair {
    0%, 27% { opacity: 0; }
    31%, 79% { opacity: 1; }
    88%, 100% { opacity: 0; }
  }

  @keyframes show-result {
    0%, 30% { opacity: 0; transform: translateX(-0.75rem); }
    37%, 82% { opacity: 1; transform: translateX(0); }
    91%, 100% { opacity: 0; transform: translateX(0); }
  }

  @keyframes show-status {
    0%, 36% { opacity: 0; }
    42%, 82% { opacity: 1; }
    91%, 100% { opacity: 0; }
  }

  .workflow {
    display: grid;
    grid-template-columns: minmax(15rem, 0.75fr) minmax(0, 1.5fr);
    gap: clamp(3rem, 8vw, 7rem);
    padding-block: var(--section-space);
    border-top: 1px solid var(--line-strong);
  }

  .section-intro h2,
  .feature-heading h2,
  .trust h2,
  .closing h2 {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 4.75rem);
    font-weight: 550;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  .section-intro p,
  .feature-heading p,
  .trust-statement > p {
    max-width: 34rem;
    margin: 1rem 0 0;
    color: var(--ink-soft);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .workflow-list { margin: 0; padding: 0; list-style: none; }

  .workflow-list li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: 0 0 2rem;
    border-bottom: 1px solid var(--line);
  }

  .workflow-list li + li { padding-top: 2rem; }
  .step-number { color: var(--blue); font-size: 1.15rem; font-weight: 600; }

  .workflow-list h3,
  .feature-copy h3,
  .trust-details h3 {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .workflow-list p,
  .feature-copy p { max-width: 35rem; margin: 0.45rem 0 0; color: var(--ink-soft); }

  kbd { padding: 0; border: 0; background: transparent; font-family: inherit; font-size: inherit; font-weight: inherit; }

  .features { padding-block: var(--section-space); background: #eaf3fb; }

  .feature-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .feature-heading h2 { max-width: 12ch; }
  .feature-heading p { max-width: 26rem; margin: 0; }

  .feature-specimens {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr 1.25fr;
    border-block: 1px solid #a8c0d3;
  }

  .feature-specimen {
    min-width: 0;
    display: flex;
    min-height: 28rem;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .feature-specimen + .feature-specimen { border-left: 1px solid #a8c0d3; }

  .qr-code {
    width: min(100%, 11rem);
    aspect-ratio: 1;
    align-self: center;
    padding: 0.65rem;
    background: white;
    color: #173750;
    shape-rendering: crispEdges;
  }

  .language-stack {
    display: grid;
    align-self: stretch;
    color: #173750;
    font-size: clamp(2.15rem, 4vw, 3.75rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.15;
  }

  .language-stack span { padding-block: 0.35rem; border-bottom: 1px solid #b7cada; }

  .code-sample {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.4ch;
    padding-top: 2.5rem;
    color: #173750;
    font-family: inherit;
    font-size: clamp(1.9rem, 3.5vw, 3.35rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .code-sample strong { color: var(--blue); font-weight: 600; }

  .trust {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(3rem, 9vw, 8rem);
    padding-block: var(--section-space);
  }

  .trust-statement h2 { max-width: 11ch; }
  .trust-details { display: grid; gap: 3rem; }

  .trust-details > div + div { padding-top: 3rem; border-top: 1px solid var(--line-strong); }

  .trust-details ul {
